. "$(dirname "$0")/../../lib.sh"
require_examples_context

# Its own namespace, like every UAT fixture: nothing a fixture creates
# may sit in $DEMO_NS, where the scenarios and the demo app live. Here
# it is load-bearing for a second reason too — see below.
NS=lookout-uat-drift

echo "▸ staging a GitOps-managed namespace and then editing it by hand"

# `stab drift` compares managedFields ownership against the GitOps
# controller, so the fixture has to fake a GitOps controller. It does
# that honestly: server-side apply with --field-manager=argocd-controller
# writes exactly the managedFields entry Argo CD writes. Nothing here
# talks to Argo CD, and nothing needs to.
#
# Its own namespace, because the manager is auto-detected as the one
# owning a MAJORITY of spec leaf fields across everything in scope. In
# lookout-demo the demo app is owned by kubectl and argocd-controller
# would never reach 50%, so the auto-detection path — the interesting
# one — could not be tested there.
#
# replicas: 0 throughout. Drift is measured from managedFields on the
# spec; no pod has to exist for an edit to have drifted, so the fixture
# schedules nothing and costs nothing.

kubectl apply -f - <<YAML
apiVersion: v1
kind: Namespace
metadata:
  name: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
YAML

for name in drift-hot drift-cold drift-clean; do
  # --force-conflicts so a re-inject over an already-drifted namespace
  # works: on the second run kubectl-edit owns the image field, and an
  # apply that did not take it back would fail on the conflict. Taking
  # ownership back is exactly what a reconcile does, and the hand edit
  # below then re-establishes the drift.
  kubectl apply --server-side --force-conflicts --field-manager=argocd-controller -f - <<YAML
apiVersion: apps/v1
kind: Deployment
metadata:
  name: $name
  namespace: $NS
  labels: { app.kubernetes.io/name: $name, app.kubernetes.io/part-of: lookout-examples }
spec:
  replicas: 0
  selector:
    matchLabels: { app.kubernetes.io/name: $name }
  template:
    metadata:
      labels: { app.kubernetes.io/name: $name }
    spec:
      terminationGracePeriodSeconds: 30
      containers:
        - name: app
          image: python:3.12-alpine
          command: ["sleep", "86400"]
          resources:
            requests: { cpu: "5m", memory: "16Mi" }
YAML
done

# (a) A high-blast-radius edit: the container image. An Update (not an
# Apply) by kubectl-edit, which is what `kubectl edit` and `kubectl set
# image` leave behind — the manager string is a TOOL, never a person.
kubectl -n "$NS" patch deployment drift-hot \
  --field-manager=kubectl-edit --type=merge \
  -p '{"spec":{"template":{"spec":{"containers":[{"name":"app","image":"python:3.11-alpine"}]}}}}' >/dev/null

# (b) A low-blast-radius edit on a different object, so the fixture
# covers BOTH severities. Nobody is paged for a grace period.
kubectl -n "$NS" patch deployment drift-cold \
  --field-manager=kubectl-patch --type=merge \
  -p '{"spec":{"template":{"spec":{"terminationGracePeriodSeconds":45}}}}' >/dev/null

# (c) drift-clean is deliberately never touched: the negative control.
# A check that reports drift on everything is indistinguishable from
# one that reports drift correctly unless something clean stays quiet.

echo "  ✓ $NS: drift-hot (image), drift-cold (grace period), drift-clean (untouched)"
