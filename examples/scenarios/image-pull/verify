. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ verify image-pull"
# The wire carries the raw kubelet reason (Failed / BackOff) — the
# ImagePullBackOff family collapse happens in the fingerprint, not the
# payload — so match the pull-shaped message, not a canonical reason.
# No kind= constraint: if a storm is open on the pod's node, the
# incident arrives as storm.member instead of a fresh k8s-event.
await_inject image-pull 300 '[Pp]ull|BackOff' 'api-'
# triage delta reads the pod's CURRENT waiting state — deterministic,
# unlike event listings whose visibility depends on kubelet retry
# pacing and event aging.
await_finding 240 'pod\.imagepull.*api-|api-.*pod\.imagepull' \
  -- triage delta --namespace="$DEMO_NS"
