. "$(dirname "$0")/../../lib.sh"
require_examples_context

command -v openssl >/dev/null 2>&1 || {
  echo "ERROR: openssl required for this scenario" >&2
  exit 1
}

stub_mark cert-expiry
echo "▸ creating a TLS secret whose cert expires in 48h"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
openssl req -x509 -newkey rsa:2048 -nodes -days 2 \
  -keyout "$tmp/tls.key" -out "$tmp/tls.crt" \
  -subj "/CN=demo.lookout-examples.invalid" >/dev/null 2>&1
kubectl -n "$DEMO_NS" create secret tls expiring-demo-cert \
  --cert="$tmp/tls.crt" --key="$tmp/tls.key" \
  --dry-run=client -o yaml | kubectl apply -f -
