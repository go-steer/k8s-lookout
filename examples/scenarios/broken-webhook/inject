. "$(dirname "$0")/../../lib.sh"
require_examples_context

NS=lookout-uat-webhook

echo "▸ creating admission webhooks with broken backends"

# SAFETY, and it is the whole design of this fixture: a
# ValidatingWebhookConfiguration is CLUSTER-scoped, and one with
# failurePolicy=Fail and a dead backend rejects every matching write.
# So every webhook here is fenced twice —
#
#   * namespaceSelector matches ONE sacrificial namespace ($NS), which
#     this fixture owns and nothing else in the examples touches; and
#   * rules match configmaps CREATE only.
#
# Worst case is that you cannot create a ConfigMap in $NS. The
# namespace is created FIRST so that the kube-root-ca.crt ConfigMap the
# API server injects into every new namespace is already there before
# the fail-closed webhook exists — otherwise namespace creation itself
# would wedge.

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

kubectl apply -f - <<YAML
apiVersion: v1
kind: Namespace
metadata:
  name: $NS
  labels:
    lookout-uat-webhook: "true"
    app.kubernetes.io/part-of: lookout-examples
YAML

await 60 "$NS has its injected kube-root-ca.crt" \
  bash -c "kubectl -n '$NS' get configmap kube-root-ca.crt >/dev/null 2>&1"

# A live backend for the slow-timeout case. slow_risk only fires when
# the backend is NOT dead — a dead backend is reported as
# failing_closed instead, never both — so this one has to genuinely
# serve, on the port the webhook names.
kubectl -n "$NS" apply -f - <<YAML
apiVersion: apps/v1
kind: Deployment
metadata:
  name: wh-backend
  namespace: $NS
  labels: { app.kubernetes.io/name: wh-backend, app.kubernetes.io/part-of: lookout-examples }
spec:
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: wh-backend }
  template:
    metadata:
      labels: { app.kubernetes.io/name: wh-backend }
    spec:
      containers:
        - name: web
          image: python:3.12-alpine
          imagePullPolicy: IfNotPresent
          command: ["python", "-m", "http.server", "8443"]
          ports:
            - { name: https, containerPort: 8443 }
          resources:
            requests: { cpu: "5m", memory: "16Mi" }
            limits: { cpu: "50m", memory: "64Mi" }
---
apiVersion: v1
kind: Service
metadata:
  name: wh-backend
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  selector: { app.kubernetes.io/name: wh-backend }
  ports:
    # 443 is the ServiceReference default and what the webhook asks
    # for; a service that exposed some other port would be reported
    # dead ("port 443 not on service") rather than slow.
    - { name: https, port: 443, targetPort: 8443 }
YAML

kubectl -n "$NS" rollout status deploy/wh-backend --timeout=120s
await 60 "wh-backend has a ready endpoint" \
  bash -c "[ -n \"\$(kubectl -n '$NS' get endpoints wh-backend -o jsonpath='{.subsets[*].addresses[*].ip}' 2>/dev/null)\" ]"

# --- CA bundles ------------------------------------------------------
#
# An EXPIRED certificate cannot be generated with `openssl req -x509`
# before OpenSSL 3.2 (`-not_after` does not exist, and -days rejects a
# negative), so it is checked in as a literal. It is a self-signed
# throwaway with no private key anywhere — a caBundle holds only the
# public certificate — and its NotAfter is 2021-01-01, which is a
# property that stays true rather than a fixture that rots.
cat >"$tmp/expired.pem" <<'PEM'
