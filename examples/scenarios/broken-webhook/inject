# The expiring one, by contrast, has to be generated: "10 days from
# now" is only inside --cert-warn=336h if `now` is now.
openssl req -x509 -newkey rsa:2048 -nodes \
  -keyout "$tmp/soon.key" -out "$tmp/soon.pem" \
  -days 10 -subj "/CN=lookout-uat-expiring-ca" >/dev/null 2>&1

EXPIRED_B64="$(base64 -w0 <"$tmp/expired.pem")"
SOON_B64="$(base64 -w0 <"$tmp/soon.pem")"

kubectl apply -f - <<YAML
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingWebhookConfiguration
metadata:
  name: lookout-uat-failclosed
  labels: { app.kubernetes.io/part-of: lookout-examples }
webhooks:
  # (a) dead backend + failurePolicy Fail → writes are REJECTED.
  - name: failclosed.uat.lookout.example.com
    admissionReviewVersions: ["v1"]
    sideEffects: None
    failurePolicy: Fail
    timeoutSeconds: 5
    namespaceSelector:
      matchLabels: { lookout-uat-webhook: "true" }
    rules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["configmaps"]
        scope: Namespaced
    clientConfig:
      service:
        # No such Service. Deliberately not "a Service with no
        # endpoints" — that is a different reason string, and the
        # fixture wants to prove the two are told apart.
        name: wh-absent
        namespace: $NS
        path: /validate
        port: 443
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingWebhookConfiguration
metadata:
  name: lookout-uat-slow
  labels: { app.kubernetes.io/part-of: lookout-examples }
webhooks:
  # (b) LIVE backend + failurePolicy Fail + a long timeout → not broken
  # now, but a hung backend stalls every matching write for 25s.
  # Also carries the soon-expiring caBundle.
  - name: slow.uat.lookout.example.com
    admissionReviewVersions: ["v1"]
    sideEffects: None
    failurePolicy: Fail
    timeoutSeconds: 25
    namespaceSelector:
      matchLabels: { lookout-uat-webhook: "true" }
    rules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["configmaps"]
        scope: Namespaced
    clientConfig:
      caBundle: $SOON_B64
      service:
        name: wh-backend
        namespace: $NS
        path: /validate
        port: 443
---
apiVersion: admissionregistration.k8s.io/v1
kind: MutatingWebhookConfiguration
metadata:
  name: lookout-uat-ignore
  labels: { app.kubernetes.io/part-of: lookout-examples }
webhooks:
  # (c) dead backend + failurePolicy Ignore → nothing is rejected and
  # nothing is enforced either, which is the quiet failure this check
  # exists for. Also carries the EXPIRED caBundle.
  - name: ignore.uat.lookout.example.com
    admissionReviewVersions: ["v1"]
    sideEffects: None
    failurePolicy: Ignore
    timeoutSeconds: 5
    namespaceSelector:
      matchLabels: { lookout-uat-webhook: "true" }
    rules:
      - apiGroups: [""]
        apiVersions: ["v1"]
        operations: ["CREATE"]
        resources: ["configmaps"]
        scope: Namespaced
    clientConfig:
      caBundle: $EXPIRED_B64
      service:
        name: wh-absent
        namespace: $NS
        path: /mutate
        port: 443
YAML

echo "  ✓ three webhook configurations, fenced to namespace $NS"
