. "$(dirname "$0")/../../lib.sh"
require_examples_context

# Its own namespace, like every UAT fixture: nothing a fixture creates
# may sit in $DEMO_NS, where the scenarios and the demo app live. This
# one especially — `edgy` never becomes Available by design, and the
# driver's preflight waits on the demo Deployments. See
# docs/testing/cli-uat.md § Fixtures.
NS=lookout-uat-edges

echo "▸ creating the edgy workload and its broken references"

# Several DIFFERENT breakages on one workload, because the claim under
# test is that `state edges` names each broken reference specifically —
# a fixture with one break can't tell "reports the missing key" from
# "reports that something is wrong".

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

kubectl apply -f - <<YAML
apiVersion: v1
kind: Namespace
metadata:
  name: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
YAML

# A TLS certificate that expires inside --cert-warn=336h but is
# otherwise valid — the "renew this" case, not the "this is broken" one.
openssl req -x509 -newkey rsa:2048 -nodes \
  -keyout "$tmp/tls.key" -out "$tmp/tls.crt" \
  -days 10 -subj "/CN=edgy.lookout-uat-edges.svc" >/dev/null 2>&1

kubectl -n "$NS" apply -f - <<YAML
apiVersion: v1
kind: ConfigMap
metadata:
  name: edgy-config
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
data:
  # The key the Deployment asks for is NOT this one.
  present-key: "hello"
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: edgy
  namespace: $NS
  labels: { app.kubernetes.io/name: edgy, app.kubernetes.io/part-of: lookout-examples }
spec:
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: edgy }
  template:
    metadata:
      labels: { app.kubernetes.io/name: edgy }
    spec:
      containers:
        - name: edgy
          image: python:3.12-alpine
          imagePullPolicy: IfNotPresent
          command: ["sleep", "86400"]
          env:
            # (a) a key that does not exist in a ConfigMap that does.
            - name: MISSING_KEY
              valueFrom:
                configMapKeyRef:
                  name: edgy-config
                  key: absent-key
          envFrom:
            # (b) a Secret that does not exist at all.
            - secretRef:
                name: edgy-absent-secret
          resources:
            requests: { cpu: "5m", memory: "16Mi" }
            limits: { cpu: "50m", memory: "32Mi" }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: edgy-ok
  namespace: $NS
  labels: { app.kubernetes.io/name: edgy-ok, app.kubernetes.io/part-of: lookout-examples }
spec:
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: edgy-ok }
  template:
    metadata:
      labels: { app.kubernetes.io/name: edgy-ok }
    spec:
      containers:
        - name: web
          image: python:3.12-alpine
          imagePullPolicy: IfNotPresent
          command: ["python", "-m", "http.server", "8080"]
          ports:
            - { name: http, containerPort: 8080 }
          resources:
            requests: { cpu: "5m", memory: "16Mi" }
            limits: { cpu: "50m", memory: "64Mi" }
---
apiVersion: v1
kind: Service
metadata:
  name: edgy-web
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  # HEALTHY on purpose, and pointed at edgy-ok rather than edgy: the
  # report-only-broken claim needs an edge that is fine and must
  # therefore NOT be listed. Aimed at \`edgy\` it would never be fine —
  # that pod is wedged in CreateContainerConfigError by design, so the
  # Service would emit selector_unready/endpoints_unready and the
  # negative assertion would have nothing to stand on.
  selector: { app.kubernetes.io/name: edgy-ok }
  ports:
    - { name: http, port: 80, targetPort: 8080 }
---
apiVersion: v1
kind: Service
metadata:
  name: edgy-ghost
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  # (c) a selector no pod carries.
  selector: { app.kubernetes.io/name: edgy-unplugged }
  ports:
    - { name: http, port: 80, targetPort: 8080 }
YAML

# (d) a TLS Secret expiring inside the warn window, reached through an
# Ingress. No ingress controller is needed — the reference is what is
# under test, not the traffic.
kubectl -n "$NS" delete secret edgy-tls --ignore-not-found >/dev/null
kubectl -n "$NS" create secret tls edgy-tls \
  --cert="$tmp/tls.crt" --key="$tmp/tls.key" >/dev/null

kubectl -n "$NS" apply -f - <<YAML
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: edgy-ing
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  ingressClassName: nginx
  tls:
    - hosts: ["edgy.lookout-uat-edges.svc"]
      secretName: edgy-tls
  rules:
    - host: edgy.lookout-uat-edges.svc
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: edgy-web
                port: { number: 80 }
YAML

# Wait for the pod to EXIST, not to become ready — it never will. A
# container whose envFrom names a missing Secret sits in
# CreateContainerConfigError forever, which is the whole point: the
# broken reference is visible in the spec, and `state edges` answers
# from the spec rather than waiting for the pod to fail.
await 120 "an edgy pod exists (it will not become ready)" \
  bash -c "[ -n \"\$(kubectl -n '$NS' get pods -l app.kubernetes.io/name=edgy -o name 2>/dev/null)\" ]"

# edgy-ok, by contrast, must actually reach Ready and land in the
# Endpoints — an "edge that is fine" that is merely *scheduled* is not
# yet fine, and asserting its absence before then would pass for the
# wrong reason.
kubectl -n "$NS" rollout status deploy/edgy-ok --timeout=120s
await 60 "edgy-web has a ready endpoint" \
  bash -c "[ -n \"\$(kubectl -n '$NS' get endpoints edgy-web -o jsonpath='{.subsets[*].addresses[*].ip}' 2>/dev/null)\" ]"
