. "$(dirname "$0")/../../lib.sh"
require_examples_context

# Its own namespace, like every UAT fixture: nothing a fixture creates
# may sit in $DEMO_NS, where the scenarios and the demo app live. See
# docs/testing/cli-uat.md § Fixtures.
NS=lookout-uat-logs

echo "▸ starting the chatty pod"

kubectl apply -f - <<YAML
apiVersion: v1
kind: Namespace
metadata:
  name: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
YAML

# The log volume is emitted ONCE, up front, and then the container
# sleeps. That matters: `triage logs` reads a window of the tail, so a
# pod still printing gives a different answer every second and no
# assertion about counts can hold. A fixed corpus makes count= a real
# number to assert on — and makes the MCP parity case's job possible.
#
# Four populations, chosen so the distillation is visible:
#   - 600 request lines, one template, variables in three positions
#   - 60 probe lines the kubelet would have produced (stripped unless
#     --keep-probes)
#   - 20 of a distinct error template
#   - 1 python traceback (log.stacktrace, frames + lang)
kubectl -n "$NS" delete pod chatty --ignore-not-found --wait=false >/dev/null
kubectl -n "$NS" wait --for=delete pod/chatty --timeout=60s >/dev/null 2>&1 || true
kubectl -n "$NS" run chatty \
  --image=python:3.12-alpine --restart=Never \
  --labels=app.kubernetes.io/name=chatty,app.kubernetes.io/part-of=lookout-examples \
  --command -- python -u -c '
import random, sys, time
random.seed(4)
for i in range(600):
    print(f"req id={random.randint(1000,9999)} path=/api/v1/widgets status=200 ms={random.randint(1,50)}")
    if i % 10 == 0:
        print(f"GET /healthz 200 ua=kube-probe/1.34 ms={random.randint(1,3)}")
    if i % 30 == 0:
        print(f"ERROR db connection refused host=10.0.0.{random.randint(2,250)} port=5432", file=sys.stderr)
print("""Traceback (most recent call last):
  File "/app/worker.py", line 88, in run
    self.flush()
  File "/app/worker.py", line 120, in flush
    raise RuntimeError("queue backlog exceeded")
RuntimeError: queue backlog exceeded""", file=sys.stderr)
sys.stdout.flush()
sys.stderr.flush()
time.sleep(86400)
'
kubectl -n "$NS" wait --for=condition=Ready pod/chatty --timeout=120s >/dev/null

# The corpus is written in well under a second, but `kubectl logs` can
# still be a line behind the container. Wait for the traceback — the
# LAST thing printed — so every later read sees the whole corpus.
await 60 "chatty finished printing its corpus" \
  bash -c "kubectl -n '$NS' logs chatty 2>/dev/null | grep -q 'queue backlog exceeded'"
