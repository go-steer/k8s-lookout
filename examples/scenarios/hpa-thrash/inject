. "$(dirname "$0")/../../lib.sh"
require_examples_context

# Its own namespace, like every UAT fixture: nothing a fixture creates
# may sit in $DEMO_NS, where the scenarios and the demo app live. See
# docs/testing/cli-uat.md § Fixtures.
NS=lookout-uat-hpa

echo "▸ building an oscillating HPA history"

fresh_namespace "$NS"

# Two real HPAs over two real Deployments. Both are pinned at
# minReplicas=1 with one replica, so neither autoscaler has any reason
# to move: the SuccessfulRescale history below is the ONLY scale
# activity in this namespace, and nothing the controller does can
# perturb it.
kubectl apply -f - <<YAML
apiVersion: apps/v1
kind: Deployment
metadata:
  name: web
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  replicas: 1
  selector: { matchLabels: { app: web } }
  template:
    metadata:
      labels: { app: web, app.kubernetes.io/part-of: lookout-examples }
    spec:
      containers:
        - name: app
          image: python:3.12-alpine
          command: ["sleep", "infinity"]
          resources:
            requests: { cpu: 50m, memory: 32Mi }
            limits: { cpu: 200m, memory: 64Mi }
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ramp
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  replicas: 1
  selector: { matchLabels: { app: ramp } }
  template:
    metadata:
      labels: { app: ramp, app.kubernetes.io/part-of: lookout-examples }
    spec:
      containers:
        - name: app
          image: python:3.12-alpine
          command: ["sleep", "infinity"]
          resources:
            requests: { cpu: 50m, memory: 32Mi }
            limits: { cpu: 200m, memory: 64Mi }
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: web
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: web }
  minReplicas: 1
  maxReplicas: 6
  metrics:
    - type: Resource
      resource:
        name: cpu
        target: { type: Utilization, averageUtilization: 50 }
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: ramp
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  scaleTargetRef: { apiVersion: apps/v1, kind: Deployment, name: ramp }
  minReplicas: 1
  maxReplicas: 6
  metrics:
    - type: Resource
      resource:
        name: cpu
        target: { type: Utilization, averageUtilization: 50 }
YAML

kubectl -n "$NS" rollout status deploy/web --timeout=180s
kubectl -n "$NS" rollout status deploy/ramp --timeout=180s

# The history is SYNTHESIZED, and that is a deliberate trade, written
# down here because it is the one place in this tree where a fixture
# does not reproduce the mechanism it tests.
#
# `triage events` recovers the replica sequence from the controller's
# SuccessfulRescale events, because the HPA object keeps no history —
# see pkg/checks/events/hpa.go. Provoking a REAL oscillation means
# alternating a CPU burst against a 5-minute scale-down stabilization
# window, so the cheapest genuine up→down→up costs ~15 minutes of wall
# clock and still only supports a fuzzy `flips>=2`. Writing the events
# the controller would have written costs a second and makes
# `replicas=3->1->3->1` and `flips=2` exact numbers to assert.
#
# What stays real: the HPA objects, their scaleTargetRefs (the
# `target=` join is a live read), the Deployments they point at, and
# the message format — copied verbatim from the controller, which is
# the actual parsing contract (`New size: N`).
rescale_event() {
  local hpa="$1" uid="$2" n="$3" size="$4" ago="$5" why="$6" ts
  ts="$(date -u -d "$ago minutes ago" +%Y-%m-%dT%H:%M:%SZ)"
  kubectl apply -f - <<YAML
apiVersion: v1
kind: Event
metadata:
  name: $hpa.rescale-$n
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
involvedObject:
  apiVersion: autoscaling/v2
  kind: HorizontalPodAutoscaler
  namespace: $NS
  name: $hpa
  uid: $uid
reason: SuccessfulRescale
message: "New size: $size; reason: $why"
type: Normal
count: 1
source:
  component: horizontal-pod-autoscaler
firstTimestamp: "$ts"
lastTimestamp: "$ts"
YAML
}

up="cpu resource utilization (percentage of request) above target"
down="All metrics below target"

# web: 3 → 1 → 3 → 1. Four sizes, three moves, TWO direction changes,
# all inside the 30m default window (and inside the 1h default --since
# lookback, or the events would be filtered before the analysis sees
# them). That is exactly the default --hpa-flips=2.
web_uid="$(kubectl -n "$NS" get hpa web -o jsonpath='{.metadata.uid}')"
rescale_event web "$web_uid" 1 3 8 "$up"
rescale_event web "$web_uid" 2 1 6 "$down"
rescale_event web "$web_uid" 3 3 4 "$up"
rescale_event web "$web_uid" 4 1 2 "$down"

# ramp: 2 → 4 → 6. The negative control, and the one that matters most
# — a monotonic ramp is the shape a busy, CORRECTLY scaling HPA makes.
# Three sizes is enough points to analyze and zero direction changes,
# so it must never be reported however fast it moved.
ramp_uid="$(kubectl -n "$NS" get hpa ramp -o jsonpath='{.metadata.uid}')"
rescale_event ramp "$ramp_uid" 1 2 9 "$up"
rescale_event ramp "$ramp_uid" 2 4 7 "$up"
rescale_event ramp "$ramp_uid" 3 6 5 "$up"

await 60 "the rescale history is readable" \
  kubectl -n "$NS" get event web.rescale-4
