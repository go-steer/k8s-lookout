# alert-excludes — UAT/e2e fixture (#836): redeploy the sentinel with
# ALERT_EXCLUDES covering Pod CrashLoopBackOff in lookout-demo (which
# also enables --store=/var/lib/lookout/lookout.db), then trigger a
# crashloop on worker so verify can assert: no k8s-event session opened,
# lookout_watch_alert_excluded_total >= 1, and an info row persisted in
# --store.

. "$(dirname "$0")/../../lib.sh"
require_examples_context

stub_mark alert-excludes

echo "▸ redeploying sentinel with ALERT_EXCLUDES + --store"
ALERT_EXCLUDES="$(cat <<YAML
excludes:
  - kind: Pod
    namespace: ${DEMO_NS}
    reason: CrashLoopBackOff
YAML
)" "$(examples_root)/sentinel/up"

echo "▸ breaking worker: command → exit(1) after 2s"
kubectl -n "$DEMO_NS" patch deployment worker --type=json -p '[
  {"op":"replace","path":"/spec/template/spec/containers/0/command",
   "value":["python","-c","import time; time.sleep(2); raise SystemExit(1)"]}
]'
