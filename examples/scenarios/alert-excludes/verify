. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ verify alert-excludes"
await_metric_ge 300 'lookout_watch_alert_exclude_rules' '' 1
await_metric_ge 300 'lookout_watch_alert_excluded_total' '' 1
await_metric_ge 60 'lookout_info_dropped_total' 'kind="k8s-event"' 1
await_metric_ge 60 'lookout_store_records_total' 'route="info-stored"' 1

refused="$(sentinel_metric_sum 'lookout_watch_alert_exclude_refused' '')"
if [[ "${refused:-0}" -ne 0 ]]; then
  echo "  ✗ lookout_watch_alert_exclude_refused=${refused}, want 0" >&2
  exit 1
fi

if ! kubectl -n "$SENTINEL_NS" logs deploy/lookout-watch --tail=-1 2>/dev/null \
  | grep -Eq "info-store k8s-event ${DEMO_NS}/worker-"; then
  echo "  ✗ sentinel log missing info-store confirmation for ${DEMO_NS}/worker-" >&2
  exit 1
fi
echo "  ✓ excluded k8s-event CrashLoopBackOff persisted as info row in --store"

wire_count="$(stub_wire_count alert-excludes 'kind=k8s-event' 'BackOff|CrashLoopBackOff' 'worker-')"
if [[ "$wire_count" -ne 0 ]]; then
  echo "  ✗ excluded CrashLoopBackOff opened ${wire_count} k8s-event inject(s), want 0" >&2
  stub_since alert-excludes | grep -E 'kind=k8s-event' | tail -n 10 >&2 || true
  exit 1
fi
echo "  ✓ no k8s-event CrashLoopBackOff session opened (lookout_watch_alert_excluded_total >= 1)"
