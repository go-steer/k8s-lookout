. "$(dirname "$0")/../../lib.sh"
require_examples_context

is_kind_context || {
  echo "ERROR: zone-unavailable is kind-only (it labels and cordons nodes)." >&2
  exit 1
}

target="${CLUSTER_NAME}-worker2"

# Cordoning the node the observer runs on would not stop it, but it
# would make this scenario depend on where the scheduler happened to
# put things. sentinel/up pins both to -worker; check rather than trust.
on_target="$(kubectl -n "$SENTINEL_NS" get pods \
  -o jsonpath='{range .items[*]}{.spec.nodeName}{"\n"}{end}' | grep -cx "$target" || true)"
if ((on_target > 0)); then
  echo "ERROR: $on_target agent-triage pod(s) run on $target. Re-run" >&2
  echo "examples/sentinel/up (it pins the sentinel + stub to ${CLUSTER_NAME}-worker)." >&2
  exit 1
fi

leeway_zones
kubectl uncordon "$target" >/dev/null
await_namespace_settled leeway-zone

echo "▸ deploying zone-hard (DoNotSchedule ×2) + zone-soft (ScheduleAnyway ×4) across both zones"
kubectl apply -f "$(dirname "$0")/workloads.yaml" >/dev/null
for d in zone-hard zone-soft; do
  kubectl -n leeway-zone rollout status "deploy/$d" --timeout=180s
done
kubectl -n leeway-zone get pods -o jsonpath='{range .items[*]}{.spec.nodeName}{"\n"}{end}' |
  sort | uniq -c | sed 's/^/    /'

# leeway latches the domains it has seen in use on a 30s tick, and a
# domain it never latched cannot be reported as lost. Only a cluster
# whose labels leeway_zones just applied needs this; it is cheap
# enough not to detect that case.
sleep 45

stub_mark zone-unavailable
# A cordon rather than examples/scenarios/node-failure's docker stop.
# Both empty the zone — Usable counts Ready AND schedulable nodes — but
# a dead node also opens objectstate and storm incidents, and its
# leeway domain alert would still be inside the 30m resolve dwell when
# node-failure stops the same node, so the two could not share a run.
echo "▸ cordoning $target: zone-b has no node the scheduler can use"
kubectl cordon "$target" >/dev/null
echo "T0: $(date -u +%Y-%m-%dT%H:%M:%SZ) — domain finding expected after the 60s dwell"
