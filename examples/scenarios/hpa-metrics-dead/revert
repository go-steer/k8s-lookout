. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ adding the missing cpu request (fix-verify half of the drill)"
kubectl -n "$DEMO_NS" patch deployment unscalable --type=json -p '[
  {"op":"add","path":"/spec/template/spec/containers/0/resources",
   "value":{"requests":{"cpu":"10m","memory":"32Mi"},
            "limits":{"cpu":"100m","memory":"64Mi"}}}
]'
kubectl -n "$DEMO_NS" rollout status deploy/unscalable --timeout=240s

# hpa_metrics_dead clears only when ScalingActive is back to True —
# not merely when the reason stops being FailedGet*. That distinction
# is the assertion worth keeping here.
soft await_inject hpa-metrics-dead 420 'kind=resolved' 'hpa_metrics_dead'

echo "▸ removing unscalable + its HPA"
kubectl delete -f "$(dirname "$0")/manifests.yaml" --ignore-not-found
