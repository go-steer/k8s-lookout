. "$(dirname "$0")/../../lib.sh"
require_examples_context

stub_mark hpa-metrics-dead
echo "▸ deploying unscalable + an HPA on CPU utilization (no cpu request)"
kubectl apply -f "$(dirname "$0")/manifests.yaml"
kubectl -n "$DEMO_NS" rollout status deploy/unscalable --timeout=180s

# Confirm the fault took the shape the source detects: ScalingActive
# must be False with a FailedGet* reason. ScalingDisabled and
# InvalidSelector are deliberately NOT metrics-dead, so a run that
# produced one of those would sit out the whole sustain window for
# nothing.
echo "▸ waiting for ScalingActive=False/FailedGet*"
_failed_get() {
  kubectl -n "$DEMO_NS" get hpa unscalable \
    -o jsonpath='{.status.conditions[?(@.type=="ScalingActive")].reason}' \
    2>/dev/null | grep -q '^FailedGet'
}
await 300 "HPA reports a FailedGet* reason" _failed_get
echo "T0 (metrics dead): $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "  MetricsDeadSustain is 15m and is not flag-tunable — verify is slow"
