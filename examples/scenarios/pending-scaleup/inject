. "$(dirname "$0")/../../lib.sh"
require_examples_context

stub_mark pending-scaleup
mkdir -p "$STATE_DIR"

{
  printf 'BASE_SCALEUP_HOLD=%s\n' "$(sentinel_metric_sum lookout_events_filtered_total 'gate="scaleup_hold"')"
  printf 'BASE_REJECTED=%s\n' "$(sentinel_metric_sum lookout_watch_scaleup_verdicts_rejected_total '')"
} >"$STATE_DIR/pending-scaleup.base"

echo "▸ creating Pod A (hog-scaleup-a) with forged cluster-autoscaler TriggeredScaleUp"
kubectl -n "$DEMO_NS" delete pod hog-scaleup-a hog-scaleup-b --ignore-not-found >/dev/null 2>&1 || true
kubectl apply -f - <<YAML
apiVersion: v1
kind: Pod
metadata:
  name: hog-scaleup-a
  namespace: $DEMO_NS
  labels:
    app.kubernetes.io/name: hog-scaleup-a
    app.kubernetes.io/part-of: lookout-examples
spec:
  restartPolicy: Never
  containers:
    - name: hog
      image: busybox:1.36
      command: ["sleep", "3600"]
      resources:
        requests:
          cpu: "64"
YAML

uid_a="$(kubectl -n "$DEMO_NS" get pod hog-scaleup-a -o jsonpath='{.metadata.uid}')"
ts_a="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
kubectl apply -f - <<YAML
apiVersion: v1
kind: Event
metadata:
  name: hog-scaleup-a-triggered
  namespace: $DEMO_NS
involvedObject:
  apiVersion: v1
  kind: Pod
  name: hog-scaleup-a
  namespace: $DEMO_NS
  uid: "$uid_a"
reason: TriggeredScaleUp
message: "pod triggered scale-up: [{kind-node-pool 1->2 (max: 3)}]"
type: Normal
count: 1
firstTimestamp: "$ts_a"
lastTimestamp: "$ts_a"
source:
  component: cluster-autoscaler
YAML
