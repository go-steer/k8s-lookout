. "$(dirname "$0")/../../lib.sh"
require_examples_context

stub_mark bad-rollout
echo "▸ rolling web to a valid-but-broken image (crashing entrypoint,"
echo "  new image string so the rollout is nameable)"
kubectl -n "$DEMO_NS" patch deployment web --type=json -p '[
  {"op":"replace","path":"/spec/template/spec/containers/0/image",
   "value":"python:3.11-alpine"},
  {"op":"replace","path":"/spec/template/spec/containers/0/command",
   "value":["python","-c","import time; time.sleep(1); raise SystemExit(1)"]}
]'
echo "T0 (rollout onset): $(date -u +%Y-%m-%dT%H:%M:%SZ)"
