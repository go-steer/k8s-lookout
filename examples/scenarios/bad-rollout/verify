. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ verify bad-rollout"

# The Deployment-altitude signal (examples --rollout-observe=90s).
#
# Its own kind=rollout.stall session, OR the same incident routed into a
# storm: crashloop and failed-mount run just before this in the same
# namespace, and when their incidents and web's first crash-looping pod
# land inside one --storm-window (1m), the correlator forms a Namespace
# storm and the stall ~80s later attaches to it as kind=storm.member
# (reason rollout_stall, name web) rather than opening a session — run
# 38927835094 (#706), where the 720s wait for a bare kind=rollout.stall
# timed out with the stall already on the wire. That is the documented
# storm behavior (README § Re-runs, dedup, and storm absorption), and
# the revert's kind=resolved still reaches whichever session owns it.
# kind=storm covers the stall being one of the founding incidents.
await_inject bad-rollout 360 'kind=(rollout\.stall|storm\.member|storm) ' 'rollout_stall' 'web'

# The exit-criterion half most worth capturing: NO user-visible
# failure while the stall is open — old pods keep serving.
echo "▸ proving user-invisibility: 5 requests through the Service"
fails=0
for _ in 1 2 3 4 5; do
  status="$(kubectl -n "$DEMO_NS" exec vantage -- python -c \
    "import urllib.request; print(urllib.request.urlopen('http://web.$DEMO_NS.svc',timeout=5).status)" \
    2>/dev/null || echo FAIL)"
  echo "    HTTP $status"
  [[ "$status" == "200" ]] || fails=$((fails + 1))
done
if ((fails > 0)); then
  echo "  ✗ $fails/5 requests failed — the stall should be user-invisible" >&2
  exit 1
fi
echo "  ✓ 5/5 requests answered 200 mid-stall"

await_finding 180 'category=rollouts status=degraded' -- health
