. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ rollout undo (fix-verify half of the drill)"
kubectl -n "$DEMO_NS" rollout undo deploy/web
kubectl -n "$DEMO_NS" rollout status deploy/web --timeout=180s

# The closed loop: the sentinel injects kind=resolved into the stall's
# own session, no agent polling. (M3 known gap: for rollout clearances
# it currently arrives fast with cleared_after=0s.)
await_inject bad-rollout 300 'kind=resolved' 'rollout_stall' 'web'
