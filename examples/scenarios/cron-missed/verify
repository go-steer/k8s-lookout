. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ verify cron-missed"

# First confirm the fault is the one we meant to inject: the schedule
# is stalled, not suspended, not invalid, not deleted. If the control
# plane advanced lastScheduleTime anyway (a Job create that failed
# AFTER the status write), the scenario proves nothing and should say
# so rather than time out looking like a detection miss.
before="$(kubectl -n "$DEMO_NS" get cronjob beat \
  -o jsonpath='{.status.lastScheduleTime}')"
echo "    lastScheduleTime at check start: $before"

# workload's Grace is 5m (not flag-tunable), swept on a 30s tick, so
# the first miss lands ~5-6m after the first blocked activation.
await_inject cron-missed 720 'workload.cron_missed' 'beat'

after="$(kubectl -n "$DEMO_NS" get cronjob beat \
  -o jsonpath='{.status.lastScheduleTime}')"
if [[ "$after" != "$before" ]]; then
  echo "  ✗ lastScheduleTime advanced ($before → $after) — the quota did" >&2
  echo "    not actually stall the schedule; see the README's fallback" >&2
  exit 1
fi
echo "  ✓ lastScheduleTime never advanced: the schedule is silently dead"

# The read-path half: a stalled CronJob is a workload-health finding,
# not something you would notice by looking at pods (there are none).
soft await_finding 120 'beat' -- health
