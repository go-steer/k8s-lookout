. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ deploying CronJob beat (every minute)"
kubectl apply -f "$(dirname "$0")/manifests.yaml"

# Not required by the source — arming is source-wide at cache sync and
# misses are judged forward from there, so a CronJob that never ran at
# all would still be reported. This wait is the scenario's own control:
# one real activation proves the schedule works BEFORE the quota goes
# on, which is what makes the later silence attributable to the quota
# rather than to a typo'd schedule.
echo "▸ waiting for the first successful activation"
_scheduled() {
  [[ -n "$(kubectl -n "$DEMO_NS" get cronjob beat \
    -o jsonpath='{.status.lastScheduleTime}' 2>/dev/null)" ]]
}
await 180 "beat has a lastScheduleTime" _scheduled

stub_mark cron-missed

echo "▸ blocking Job creation (ResourceQuota count/jobs.batch=0)"
kubectl apply -f "$(dirname "$0")/quota.yaml"
echo "T0 (schedule stops): $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "  the CronJob stays unsuspended and valid; only its Jobs stop"
