. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ lifting the quota (fix-verify half of the drill)"
kubectl delete -f "$(dirname "$0")/quota.yaml" --ignore-not-found

# The closed loop: cron_missed clears as recovered when
# lastScheduleTime advances past the missed activation — the next
# minute's run, plus --recovery-stable-for.
soft await_inject cron-missed 420 'kind=resolved' 'cron_missed'

echo "▸ removing CronJob beat"
kubectl delete -f "$(dirname "$0")/manifests.yaml" --ignore-not-found
