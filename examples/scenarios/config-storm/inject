. "$(dirname "$0")/../../lib.sh"
require_examples_context

# Own namespace, fresh name every run — see ns.sh for why the name
# cannot be a constant. manifests.yaml carries no metadata.namespace.
. "$(dirname "$0")/ns.sh"
config_storm_sweep
NS="$(config_storm_new_ns)"

echo "▸ deploying four consumers of ConfigMap shared-config into $NS"
fresh_namespace "$NS"
kubectl apply -n "$NS" -f "$(dirname "$0")/manifests.yaml"
for d in consumer-a consumer-b consumer-c consumer-d; do
  kubectl -n "$NS" rollout status "deploy/$d" --timeout=180s
done

# The spread is load-bearing, not cosmetic: if all four consumers sit
# on one node the correlator keys the storm on the NODE (§7.5 ranks it
# above the shared ConfigMap) and verify fails 240s later with nothing
# to point at. Check it here, where the message can say what happened.
echo "▸ checking the consumers spread across nodes"
per_node="$(kubectl -n "$NS" get pods -l app.kubernetes.io/component=config-consumer \
  -o jsonpath='{range .items[*]}{.spec.nodeName}{"\n"}{end}' | sort | uniq -c)"
echo "$per_node" | sed 's/^/    /'
max_on_one_node="$(awk '{print $1}' <<<"$per_node" | sort -rn | head -n1)"
if ((max_on_one_node >= 3)); then
  echo "  ✗ $max_on_one_node consumers on one node — at or above --storm-min (3)," >&2
  echo "    so the storm would key on the Node, not shared-config. Needs a" >&2
  echo "    cluster with >= 2 schedulable nodes (examples/kind/up gives two)." >&2
  exit 1
fi
echo "  ✓ no node holds --storm-min (3) consumers"

# Mark AFTER the baseline is healthy: the storm must form from the
# fault, not from the initial scheduling churn.
stub_mark config-storm

echo "▸ deleting shared-config, then restarting all four at once"
kubectl -n "$NS" delete configmap shared-config
# One command, four rollouts: the four FailedMount incidents have to
# land inside --storm-window (60s) for the correlator to fold them.
kubectl -n "$NS" rollout restart deploy/consumer-a deploy/consumer-b \
  deploy/consumer-c deploy/consumer-d
echo "T0 (blast): $(date -u +%Y-%m-%dT%H:%M:%SZ)"
