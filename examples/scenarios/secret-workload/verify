. "$(dirname "$0")/../../lib.sh"
require_examples_context

# A fixture, not a failure: read-path smoke only. The redaction
# contract — the canary must not appear in ANY command's output — is
# asserted by examples/uat-cases/40-toplevel.sh.
echo "▸ verify secret-workload"
await_finding 60 'kind=spec.container.*name=keeper' \
  -- triage spec Deployment/lookout-uat-secrets/keeper

if run_lookout triage spec Deployment/lookout-uat-secrets/keeper 2>/dev/null |
  grep -q 'c4nary-Sh0uld-Never-Appear-9f3a2b'; then
  echo "  ✗ the canary secret value appeared in triage spec output" >&2
  exit 1
fi
echo "  ✓ triage spec names the secret and prints none of its values"
