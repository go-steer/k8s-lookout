. "$(dirname "$0")/../../lib.sh"
require_examples_context

# Its own namespace, like every UAT fixture: nothing a fixture creates
# may sit in $DEMO_NS, where the scenarios and the demo app live. See
# docs/testing/cli-uat.md § Fixtures.
NS=lookout-uat-secrets

echo "▸ staging a workload that consumes a Secret four different ways"

# The redaction contract is the one assertion in this whole layer where
# a false PASS is a security bug rather than a missing test, so the
# fixture is built to make a leak impossible to miss: every secret
# value is the same distinctive canary string. A single grep for it
# across every command's output is then a complete answer, and it
# cannot be satisfied by a command that merely happens to print
# nothing.
#
# Four consumption paths, because the redaction has to hold on all of
# them and they take different code:
#
#   1. envFrom.secretRef       — the whole Secret as environment
#   2. env[].valueFrom.secretKeyRef — one key
#   3. a projected volume mount
#   4. imagePullSecrets        — a reference, not a value, but it is a
#                                Secret name in a spec field of its own
#
# It is also the `triage spec` default-elision target: the Deployment
# below sets almost nothing beyond what it needs, so anything the
# command prints that is not here is a default it failed to elide.

fresh_namespace "$NS"

# The canary. Three character classes and no dictionary word, so it
# cannot collide with anything a command legitimately prints, and it is
# recognizable at a glance in a diff if it ever does escape.
CANARY='c4nary-Sh0uld-Never-Appear-9f3a2b'

kubectl -n "$NS" delete secret vault-creds vault-pull --ignore-not-found >/dev/null
kubectl -n "$NS" create secret generic vault-creds \
  --from-literal=api-token="$CANARY" \
  --from-literal=db-password="$CANARY" >/dev/null
kubectl -n "$NS" label secret vault-creds app.kubernetes.io/part-of=lookout-examples >/dev/null

# A real dockerconfigjson, so the imagePullSecrets path is exercised
# with a Secret of the type it actually has in production. The password
# is the canary again: a pull secret is the most embarrassing thing to
# print.
kubectl -n "$NS" create secret docker-registry vault-pull \
  --docker-server=registry.invalid \
  --docker-username=robot \
  --docker-password="$CANARY" >/dev/null
kubectl -n "$NS" label secret vault-pull app.kubernetes.io/part-of=lookout-examples >/dev/null

kubectl apply -f - <<YAML
apiVersion: apps/v1
kind: Deployment
metadata:
  name: keeper
  namespace: $NS
  labels: { app.kubernetes.io/name: keeper, app.kubernetes.io/part-of: lookout-examples }
spec:
  replicas: 1
  selector:
    matchLabels: { app.kubernetes.io/name: keeper }
  template:
    metadata:
      labels: { app.kubernetes.io/name: keeper, app.kubernetes.io/part-of: lookout-examples }
    spec:
      imagePullSecrets:
        - name: vault-pull
      containers:
        - name: keeper
          image: python:3.12-alpine
          command: ["python", "-u", "-c", "import time; print('keeper up'); time.sleep(86400)"]
          envFrom:
            - secretRef: { name: vault-creds }
          env:
            - name: DB_PASSWORD
              valueFrom:
                secretKeyRef: { name: vault-creds, key: db-password }
          volumeMounts:
            - { name: creds, mountPath: /etc/vault, readOnly: true }
          resources:
            requests: { cpu: "5m", memory: "24Mi" }
      volumes:
        - name: creds
          secret: { secretName: vault-creds }
---
apiVersion: v1
kind: Service
metadata:
  name: keeper
  namespace: $NS
  labels: { app.kubernetes.io/part-of: lookout-examples }
spec:
  selector: { app.kubernetes.io/name: keeper }
  ports:
    - { name: http, port: 80, targetPort: 8080 }
YAML

# imagePullSecrets points at a registry that does not exist, but the
# image itself is already on the node from the other fixtures, so the
# pull secret is never used and the pod starts. That is deliberate: the
# spec field has to be POPULATED for the redaction path to run, and a
# pod stuck on an image pull would give the wrong findings everywhere
# else.
kubectl -n "$NS" rollout status deploy/keeper --timeout=180s

echo "  ✓ $NS: keeper consumes vault-creds by envFrom, secretKeyRef and mount, and vault-pull as an imagePullSecret"
