. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ verify node-failure"
await_inject node-failure 300 'objectstate.node_notready' 'worker2'
# Storm formation needs >= --storm-min incidents inside the window;
# how many pods sat on the dead worker varies run to run, so this
# check is soft — the M2 record shows the full 33-member version.
soft await_inject node-failure 180 'kind=storm' 'worker2'
await_finding 240 'category=nodes status=degraded' -- health
