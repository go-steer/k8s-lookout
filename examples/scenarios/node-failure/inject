. "$(dirname "$0")/../../lib.sh"
require_examples_context

is_kind_context || {
  echo "ERROR: node-failure is kind-only (docker stop). For real" >&2
  echo "clusters use the dev/drills/node-failure.md runbook." >&2
  exit 1
}

target="${CLUSTER_NAME}-worker2"
kubectl get node "$target" >/dev/null

# Refuse if the sentinel or stub live on the target (sentinel/up pins
# them to -worker, but don't trust — verify).
on_target="$(kubectl -n "$SENTINEL_NS" get pods \
  -o jsonpath='{range .items[*]}{.spec.nodeName}{"\n"}{end}' | grep -cx "$target" || true)"
if ((on_target > 0)); then
  echo "ERROR: $on_target agent-triage pod(s) run on $target — the drill" >&2
  echo "would kill its own observer. Re-run examples/sentinel/up (it pins" >&2
  echo "the sentinel + stub to ${CLUSTER_NAME}-worker)." >&2
  exit 1
fi

stub_mark node-failure
echo "▸ docker stop $target (hard kubelet death)"
docker stop "$target"
echo "T0: $(date -u +%Y-%m-%dT%H:%M:%SZ) — detection expected in ~40-60s"
