. "$(dirname "$0")/../../lib.sh"
require_examples_context

echo "▸ verify placement-drift"

# 60s dwell (examples/sentinel/up) + the next evaluation pass. The
# Tier B finding then waits up to --watchboard-flush (1m) in the digest
# buffer, so it can trail the Tier A one by a minute.
await_inject placement-drift 300 'leeway\.contract_violated' 'spread-hard'
await_inject placement-drift 240 'leeway\.placement_drift' 'spread-soft'

# The other half of the contract: lifting a taint is not losing a
# domain. zone-b was Ready and schedulable throughout, so a
# domain_unavailable here would mean the census is reading per-subject
# eligibility, and every tainted pool in a real cluster would page.
n="$(leeway_wire_count placement-drift 'leeway\.domain_unavailable')"
if ((n > 0)); then
  echo "  ✗ $n leeway.domain_unavailable line(s) on the wire — a taint emptied a domain" >&2
  stub_since placement-drift | grep -E 'leeway\.domain_unavailable' | cut -c1-200 | sed 's/^/    wire: /' >&2
  exit 1
fi
echo "  ✓ no leeway.domain_unavailable: the hold never read as a lost zone"
