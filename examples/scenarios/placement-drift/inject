. "$(dirname "$0")/../../lib.sh"
require_examples_context

is_kind_context || {
  echo "ERROR: placement-drift is kind-only (it labels and taints nodes)." >&2
  exit 1
}

target="${CLUSTER_NAME}-worker2"
hold="lookout-examples/leeway-hold=true:NoSchedule"

leeway_zones
await_namespace_settled leeway-drift

# The hold, NOT a cordon. A cordon empties zone-b of usable nodes,
# which is leeway.domain_unavailable plus §7.6's drain relaxation for
# every workload — the zone-unavailable scenario, not this one. A taint
# nobody tolerates leaves the node Ready and schedulable for leeway's
# domain census and removes it only for the subjects that honour it.
echo "▸ holding zone-b ($target) behind $hold"
kubectl taint node "$target" "$hold" --overwrite >/dev/null

stub_mark placement-drift
echo "▸ deploying spread-hard (DoNotSchedule) + spread-soft (ScheduleAnyway), 4 replicas each"
kubectl apply -f "$(dirname "$0")/workloads.yaml" >/dev/null
for d in spread-hard spread-soft; do
  kubectl -n leeway-drift rollout status "deploy/$d" --timeout=180s
done

# Every replica must be in zone-a before the hold lifts, or the drift
# this scenario claims to cause was never there.
placed="$(kubectl -n leeway-drift get pods -o jsonpath='{range .items[*]}{.spec.nodeName}{"\n"}{end}' | sort | uniq -c)"
echo "$placed" | sed 's/^/    /'
if grep -q "$target" <<<"$placed"; then
  echo "ERROR: a replica landed on $target despite the hold — the drift would not be real" >&2
  exit 1
fi

echo "▸ lifting the hold: zone-b is eligible again and holds none of the 8 replicas"
kubectl taint node "$target" "${hold%%=*}:NoSchedule-" >/dev/null
echo "T0: $(date -u +%Y-%m-%dT%H:%M:%SZ) — findings expected after the 60s dwell"
