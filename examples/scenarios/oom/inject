. "$(dirname "$0")/../../lib.sh"
require_examples_context

stub_mark oom
echo "▸ deploying leaker (drill-speed memory leak vs a 64Mi limit)"
kubectl -n "$DEMO_NS" create configmap memory-leaker \
  --from-file=memory-leaker.py="$(repo_root)/dev/drills/memory-leaker.py" \
  --dry-run=client -o yaml | kubectl apply -f -
kubectl apply -f "$(dirname "$0")/leaker.yaml"
