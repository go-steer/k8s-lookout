# soak — run the WHOLE sentinel, resident MCP server, and continuous
# posture baselining (`audit all -A | findings diff --store=…`) against
# the synthetic fleet under sustained churn for hours, and answer two
# questions:
#   1. Does resident memory (`lookout watch` and `lookout mcp`) track
#      the fleet, or does it outgrow it?
#   2. Do continuous posture sweeps and `findings diff` SQLite baseline
#      transitions stay error-free and bounded under rollout churn?
#
# This is §6.6.1's steady-state soak, and it is deliberately
# `lookout watch` with every source live rather than the standalone
# `leeway` binary, paired with a resident `lookout mcp` HTTP daemon and
# periodic `audit all -A | findings diff` sweeps.
#
# Usage:
#   examples/kwok/soak            # 2 hours, 4 rollout drivers, watch + mcp + audit/diff
#   examples/kwok/soak --report   # re-read the last run of samples
#   examples/kwok/soak --selftest # check the verdict against synthetic
#                                 # series; needs no cluster
#
# Env:
#   LEEWAY_SOAK_HOURS            wall-clock hours to soak for (default 2)
#   LEEWAY_SOAK_SAMPLE           seconds between samples (default 30)
#   LEEWAY_SOAK_CHURN            parallel rollout drivers (default 4; 0 is
#                                a quiet soak, which measures much less)
#   LEEWAY_SOAK_WARMUP           seconds to exclude from the fit (default 600)
#   LEEWAY_SOAK_TOLERANCE        max 24 h projected growth, as a fraction of
#                                the mean, before the verdict is a leak
#                                (default 0.10)
#   LEEWAY_SOAK_MCP              1 to soak resident `lookout mcp` under tool
#                                traffic alongside `lookout watch` (default 1)
#   LEEWAY_SOAK_AUDIT            1 to run periodic `audit all -A | findings diff`
#                                posture baselining throughout the soak (default 1)
#   LEEWAY_SOAK_AUDIT_INTERVAL   seconds between posture + MCP rounds (default 60)
#   LEEWAY_SOAK_STORE_TOLERANCE  max relative SQLite store growth between the
#                                first and second post-warmup halves (default 0.25)
#
# Needs the fleet to be up: examples/kwok/up then examples/kwok/scale-up.

set -euo pipefail
. "$(dirname "$0")/lib.sh"

HOURS="${LEEWAY_SOAK_HOURS:-2}"
SAMPLE="${LEEWAY_SOAK_SAMPLE:-30}"
CHURN="${LEEWAY_SOAK_CHURN:-4}"
WARMUP="${LEEWAY_SOAK_WARMUP:-600}"
TOLERANCE="${LEEWAY_SOAK_TOLERANCE:-0.10}"
SOAK_MCP="${LEEWAY_SOAK_MCP:-1}"
SOAK_AUDIT="${LEEWAY_SOAK_AUDIT:-1}"
AUDIT_INTERVAL="${LEEWAY_SOAK_AUDIT_INTERVAL:-60}"
STORE_TOLERANCE="${LEEWAY_SOAK_STORE_TOLERANCE:-0.25}"

SAMPLES="$STATE_DIR/soak-samples.tsv"
MCP_SAMPLES="$STATE_DIR/soak-mcp-samples.tsv"
POSTURE_SAMPLES="$STATE_DIR/soak-posture.tsv"

# ---- the verdict ----------------------------------------------------------

# Least squares, in awk, because the alternative is a Python dependency
# in an examples/ script that has none.
#
# WHICH TEST IS THE VERDICT depends on what the fleet did, and the two
# cases are different measurements rather than one measurement with a
# different threshold:
#
#   Flat fleet   — RSS against TIME. This is the classic leak test and
#                  it is only valid when the denominator holds still.
#   Fleet grows  — RSS against OBJECT COUNT, fitted separately over each
#                  half of the window. The question is whether the Nth
#                  object costs more than the first, which is what
#                  unbounded retention looks like, and answering it needs
#                  no extrapolation in time at all.
report_series() {
  local file="${1:-$SAMPLES}" label="${2:-lookout watch}"
  if [[ ! -s "$file" ]]; then
    echo "▸ no samples yet ($label) — run examples/kwok/soak"
    return 0
  fi

  awk -F'\t' -v warmup="$WARMUP" -v tol="$TOLERANCE" -v proc="$label" '
    { t[NR] = $1; rss[NR] = $2; heap[NR] = $3; objs[NR] = $4; last = NR }

    # Least squares of y on x over the inclusive index range [lo, hi].
    # The results land in globals rather than in a return value, because
    # awk has one of those and this needs three.
    function fitxy(x, y, lo, hi,   i, k, sx, sy, sxx, sxy, d) {
      k = 0
      for (i = lo; i <= hi; i++) {
        k++
        sx += x[i]; sy += y[i]; sxx += x[i] * x[i]; sxy += x[i] * y[i]
      }
      fit_n = k; fit_ok = 0
      if (k < 3) return 0
      d = k * sxx - sx * sx
      if (d == 0) return 0
      fit_m = (k * sxy - sx * sy) / d
      fit_mean = sy / k
      fit_ok = 1
      return 1
    }

    function drift(y, lo, hi, label, unit,   span) {
      if (!fitxy(t, y, lo, hi)) {
        printf "  %-14s no usable fit over the window (%d samples)\n", label, fit_n
        return
      }
      span = t[hi] - t[lo]
      printf "  %-14s mean %8.1f %-3s  drift %+8.1f %s over %.1f h  → 24 h %+9.1f %s (%+.1f%% of mean)\n",
        label, fit_mean, unit, fit_m * span, unit, span / 3600,
        fit_m * 86400, unit, (fit_mean > 0 ? fit_m * 86400 / fit_mean * 100 : 0)
    }

    END {
      printf "\n▸ %s: %d samples over %.2f h\n", proc, last, (t[last] - t[1]) / 3600
      w1 = 0
      for (i = 1; i <= last; i++) if (t[i] >= warmup) { w1 = i; break }
      if (!w1 || last - w1 < 5) {
        printf "  ? %d samples past the %ds warm-up is not enough to fit — soak longer\n",
          (w1 ? last - w1 + 1 : 0), warmup
        exit 0
      }
      printf "  fitted over the %d samples from %ds to %ds\n\n", last - w1 + 1, t[w1], t[last]
      if ((t[last] - t[w1]) < 3600)
        printf "  ⚠ under an hour of fitted window: read every 24 h projection below\n    as a direction rather than a number.\n\n"

      drift(rss, w1, last, "RSS", "MiB")
      rss_ok = fit_ok; rss_mean = fit_mean; rss_24h = fit_m * 86400
      drift(heap, w1, last, "Go heap", "MiB")
      printf "\n"

      printf "  %-14s %d objects at %ds → %d at %ds (%+.1f%%)\n",
        "fleet", objs[w1], t[w1], objs[last], t[last],
        (objs[w1] > 0 ? (objs[last] - objs[w1]) / objs[w1] * 100 : 0)
      if (objs[w1] <= 0 || objs[last] <= 0) {
        print "\n  ? the fleet control read zero, so there is no denominator and"
        print "    no verdict. Re-run the soak."
        exit 0
      }
      printf "  %-14s %.1f KiB at %ds → %.1f KiB at %ds\n\n", "RSS/object",
        rss[w1] * 1024 / objs[w1], t[w1], rss[last] * 1024 / objs[last], t[last]

      omin = omax = objs[w1]
      for (i = w1; i <= last; i++) {
        if (objs[i] < omin) omin = objs[i]
        if (objs[i] > omax) omax = objs[i]
      }
      moved = (omax - omin) / omax

      if (moved < 0.05) {
        printf "  the fleet moved %.1f%% across the window, so the verdict is RSS\n  against time.\n\n", moved * 100
        if (!rss_ok || rss_mean <= 0) {
          print "  ? no RSS fit, so no verdict"
          exit 0
        }
        if (rss_24h / rss_mean > tol) {
          printf "  ✗ NOT FLAT: RSS projects %+.1f%% over 24 h against a fleet that did\n    not grow, tolerance is %.0f%%.\n",
            rss_24h / rss_mean * 100, tol * 100
          print "    Read the Go heap line before calling it a leak: a flat heap"
          print "    under a rising RSS is the allocator, not retention."
          exit 1
        }
        printf "  ✓ FLAT: RSS projects %+.1f%% over 24 h, inside the %.0f%% tolerance.\n",
          rss_24h / rss_mean * 100, tol * 100
        exit 0
      }

      printf "  the fleet moved %.1f%% across the window, so the verdict is the\n  marginal resident cost of an object, fitted over each half.\n\n", moved * 100
      mid = int((w1 + last) / 2)
      if (!fitxy(objs, rss, w1, mid)) {
        print "  ? the first half has no usable RSS-against-objects fit, so no verdict"
        exit 0
      }
      m1 = fit_m * 1024
      if (!fitxy(objs, rss, mid, last)) {
        print "  ? the second half has no usable RSS-against-objects fit, so no verdict"
        exit 0
      }
      m2 = fit_m * 1024
      printf "  %-14s %.1f KiB/object over the first half, %.1f over the second\n\n",
        "marginal", m1, m2
      if (m1 <= 0) {
        print "  ? the first half fitted a non-positive marginal cost, which is noise"
        print "    rather than a measurement. Soak longer, or churn harder."
        exit 0
      }
      if ((m2 - m1) / m1 > tol) {
        printf "  ✗ DRIFTING: each fleet object costs %+.1f%% more resident in the second\n    half than in the first, tolerance is %.0f%%. Later objects costing more\n    than earlier ones is what unbounded retention looks like.\n",
          (m2 - m1) / m1 * 100, tol * 100
        print "    Read the Go heap line before calling it a leak: a flat heap"
        print "    under a rising RSS is the allocator, not retention."
        exit 1
      }
      printf "  ✓ STABLE: the marginal cost changed %+.1f%% between the halves, inside\n    the %.0f%% tolerance — the RSS rise above is the fleet growing under the\n    churn drivers, not retention.\n",
        (m2 - m1) / m1 * 100, tol * 100
    }
  ' "$file"
}

# report_posture <tsv> — evaluate the periodic `audit all -A | findings diff`
# and MCP tool-call rounds recorded during the soak.
# Columns: elapsed \t audit_rc \t diff_rc \t mcp_rc \t scanned \t findings \t new \t ongoing \t resolved \t store_kib
report_posture() {
  local file="${1:-$POSTURE_SAMPLES}"
  [[ -s "$file" ]] || return 0

  awk -F'\t' -v warmup="$WARMUP" -v stol="$STORE_TOLERANCE" '
    {
      t[NR] = $1
      arc[NR] = $2; drc[NR] = $3; mrc[NR] = $4
      scanned[NR] = $5; findings[NR] = $6
      fnew[NR] = $7; ongoing[NR] = $8; resolved[NR] = $9
      store[NR] = $10
      if (arc[NR] != 0 || drc[NR] != 0 || mrc[NR] != 0) errs++
      last = NR
    }
    END {
      printf "\n▸ posture & MCP soak: %d rounds over %.2f h\n", last, (t[last] - t[1]) / 3600
      printf "  %-14s scanned=%d findings=%d (round 1: new=%d) → (last: new=%d ongoing=%d resolved=%d)\n",
        "audit/diff", scanned[last], findings[last], fnew[1], fnew[last], ongoing[last], resolved[last]
      printf "  %-14s %.1f KiB at %ds → %.1f KiB at %ds\n",
        "SQLite store", store[1], t[1], store[last], t[last]

      if (errs > 0) {
        printf "\n  ✗ POSTURE/MCP ERRORS: %d of %d round(s) exited non-zero.\n", errs, last
        exit 1
      }

      w1 = 0
      for (i = 1; i <= last; i++) if (t[i] >= warmup) { w1 = i; break }
      if (!w1 || last - w1 < 3) {
        printf "\n  ✓ POSTURE OK (%d error-free rounds; <4 rounds past warm-up for store drift fit)\n", last
        exit 0
      }

      mid = int((w1 + last) / 2)
      s1 = 0; n1 = 0
      for (i = w1; i <= mid; i++) { s1 += store[i]; n1++ }
      s2 = 0; n2 = 0
      for (i = mid + 1; i <= last; i++) { s2 += store[i]; n2++ }
      mean1 = (n1 > 0 ? s1 / n1 : 0)
      mean2 = (n2 > 0 ? s2 / n2 : 0)

      # SQLite allocates in page chunks; ignore sub-512 KiB absolute movement
      # so a fresh store settling its WAL does not trip the percentage gate.
      if (mean1 > 0 && (mean2 - mean1) > 512 && (mean2 - mean1) / mean1 > stol) {
        printf "\n  ✗ STORE DRIFTING: SQLite baseline store grew %+.1f%% between post-warmup halves\n    (%.1f KiB → %.1f KiB, tolerance %.0f%%).\n",
          (mean2 - mean1) / mean1 * 100, mean1, mean2, stol * 100
        exit 1
      }
      printf "\n  ✓ POSTURE & STORE STABLE: %d error-free rounds, SQLite store %+.1f%% across post-warmup halves.\n",
        last, (mean1 > 0 ? (mean2 - mean1) / mean1 * 100 : 0)
    }
  ' "$file"
}

report() {
  local rc=0
  report_series "$SAMPLES" "lookout watch" || rc=1
  if [[ -s "$MCP_SAMPLES" ]]; then
    report_series "$MCP_SAMPLES" "lookout mcp" || rc=1
  fi
  if [[ -s "$POSTURE_SAMPLES" ]]; then
    report_posture "$POSTURE_SAMPLES" || rc=1
  fi
  return "$rc"
}

# ---- the self-test --------------------------------------------------------

# Synthetic series whose answer is known by construction, fed through the
# real report(). Needs no cluster, no kwok and no fleet, and runs in
# about a second.
gen_series() { # gen_series <mode> <file>
  awk -v mode="$1" 'BEGIN {
    n = 240; rss = 300; objs = 20000; heap = 800
    for (i = 0; i < n; i++) {
      t = i * 30
      if (mode == "grow-leak") {
        printf "%d\t%.1f\t%.1f\t%d\n", t, rss, heap, objs
        rss += 100 * (50 + 30 * i / n) / 1024
        objs += 100
        continue
      }
      if (mode == "short" && i >= 23) break
      if (mode == "flat-ok")    { rss = 1000 + (i % 5); objs = 20000 }
      if (mode == "flat-leak")  { rss = 1000 + t * 100 / 3600; objs = 20000 }
      if (mode == "grow-ok")    { objs = 20000 + i * 100; rss = 300 + objs * 50 / 1024 }
      if (mode == "short")      { rss = 1000; objs = 20000 }
      if (mode == "no-control") { rss = 1000; objs = 0 }
      printf "%d\t%.1f\t%.1f\t%d\n", t, rss, heap, objs
    }
  }' >"$2"
}

gen_posture_series() { # gen_posture_series <mode> <file>
  awk -v mode="$1" 'BEGIN {
    n = 60
    for (i = 0; i < n; i++) {
      t = i * 60
      arc = 0; drc = 0; mrc = 0
      scanned = 1200; findings = 450
      fnew = (i == 0 ? 450 : 0)
      ongoing = (i == 0 ? 0 : 450)
      resolved = 0
      store = 1024 + (i % 4) * 8
      if (mode == "posture-store-leak") {
        store = 1024 + i * 64
      }
      if (mode == "posture-err" && i == 15) {
        mrc = 1
      }
      printf "%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%.1f\n",
        t, arc, drc, mrc, scanned, findings, fnew, ongoing, resolved, store
    }
  }' >"$2"
}

selftest() {
  local dir out rc name want_rc want_msg fails=0
  dir="$(mktemp -d)"
  MCP_SAMPLES="$dir/none-mcp.tsv"
  POSTURE_SAMPLES="$dir/none-posture.tsv"
  echo "▸ soak verdict self-test"
  while read -r name want_rc want_msg; do
    [[ -n "$name" ]] || continue
    gen_series "$name" "$dir/$name.tsv"
    SAMPLES="$dir/$name.tsv"
    out="$(report 2>&1)" && rc=0 || rc=$?
    if [[ "$rc" != "$want_rc" || "$out" != *"$want_msg"* ]]; then
      fails=$((fails + 1))
      printf "  ✗ %-18s wanted exit %s and %s, got exit %s\n" "$name" "$want_rc" "$want_msg" "$rc"
      printf '%s\n' "$out" | sed 's/^/      /'
    else
      printf "  ✓ %-18s exit %s, %s\n" "$name" "$rc" "$want_msg"
    fi
  done <<'CASES'
flat-ok 0 ✓ FLAT
flat-leak 1 ✗ NOT FLAT
grow-ok 0 ✓ STABLE
grow-leak 1 ✗ DRIFTING
short 0 not enough to fit
no-control 0 no denominator
CASES

  while read -r name want_rc want_msg; do
    [[ -n "$name" ]] || continue
    gen_posture_series "$name" "$dir/$name.tsv"
    out="$(report_posture "$dir/$name.tsv" 2>&1)" && rc=0 || rc=$?
    if [[ "$rc" != "$want_rc" || "$out" != *"$want_msg"* ]]; then
      fails=$((fails + 1))
      printf "  ✗ %-18s wanted exit %s and %s, got exit %s\n" "$name" "$want_rc" "$want_msg" "$rc"
      printf '%s\n' "$out" | sed 's/^/      /'
    else
      printf "  ✓ %-18s exit %s, %s\n" "$name" "$rc" "$want_msg"
    fi
  done <<'PCASES'
posture-ok 0 ✓ POSTURE & STORE STABLE
posture-store-leak 1 ✗ STORE DRIFTING
posture-err 1 ✗ POSTURE/MCP ERRORS
PCASES

  rm -rf "$dir"
  if ((fails > 0)); then
    echo "▸ $fails case(s) failed"
    return 1
  fi
  echo "▸ all cases agreed"
}

if [[ "${1:-}" == "--report" ]]; then
  report
  exit
fi

if [[ "${1:-}" == "--selftest" ]]; then
  selftest
  exit
fi

# ---- preflight ------------------------------------------------------------

require_examples_context
require_kwok_installed

nodes="$(kubectl get nodes --no-headers | wc -l | tr -d ' ')"
pods="$(kubectl get pods -A --no-headers | wc -l | tr -d ' ')"
fake="$(fake_node_count)"
echo "▸ cluster: ${nodes} nodes, ${pods} pods (${fake} faked by kwok)"

if ((fake == 0)); then
  echo "ERROR: no fake nodes — run examples/kwok/scale-up first. Soaking an" >&2
  echo "       empty cluster measures nothing." >&2
  exit 1
fi

if [[ -z "${LOOKOUT_BIN:-}" ]]; then
  LOOKOUT_BIN="$STATE_DIR/bin/lookout-soak"
  mkdir -p "$STATE_DIR/bin"
  echo "▸ building lookout from the worktree into $LOOKOUT_BIN" >&2
  (cd "$(repo_root)" && go build -o "$LOOKOUT_BIN" ./cmd/lookout)
  export LOOKOUT_BIN
fi
bin="$(lookout_bin)"
echo "▸ binary:  $bin ($("$bin" version 2>/dev/null | head -1))"

# ---- the sentinel & resident MCP server -----------------------------------

addr="127.0.0.1:${LEEWAY_SOAK_PORT:-39090}"
mcp_addr="127.0.0.1:${LEEWAY_SOAK_MCP_PORT:-39091}"
log="$STATE_DIR/soak-sentinel.log"
mcp_log="$STATE_DIR/soak-mcp.log"
soak_store="$STATE_DIR/soak-findings.db"
soak_exemptions="$STATE_DIR/soak-exemptions.yaml"
mkdir -p "$STATE_DIR"
rm -f "$soak_store" "$soak_store-wal" "$soak_store-shm" "$MCP_SAMPLES" "$POSTURE_SAMPLES"

cat >"$soak_exemptions" <<'YAML'
exemptions:
  - kind: audit.no_pdb
    namespace: kwok-fleet-00
    name: svc-0001
    owner: platform-soak
    reason: "Soak fixture — exercises exemption matching on every posture sweep"
    expires: "2099-01-01"
YAML

"$bin" watch \
  --dry-run \
  --sources=auto \
  --cluster-name=kwok-soak \
  --metrics-addr="$addr" \
  >/dev/null 2>"$log" &
pid=$!

mcp_pid=""
mcp_sid=""
if ((SOAK_MCP)); then
  "$bin" mcp \
    --listen="$mcp_addr" \
    --store="$soak_store" \
    --exemptions="$soak_exemptions" \
    --max-response-bytes=0 \
    >"$mcp_log" 2>&1 &
  mcp_pid=$!
fi

cleanup() {
  kill "$pid" 2>/dev/null || true
  [[ -n "$mcp_pid" ]] && kill "$mcp_pid" 2>/dev/null || true
  local j
  for j in $(jobs -p); do kill "$j" 2>/dev/null || true; done
}
trap cleanup EXIT
echo "▸ sentinel pid $pid on $addr (log: $log)"

ready=""
for _ in $(seq 1 1200); do
  if curl -fsS "http://$addr/readyz" >/dev/null 2>&1; then
    ready=yes
    break
  fi
  kill -0 "$pid" 2>/dev/null || {
    echo "ERROR: the sentinel exited during startup:" >&2
    tail -20 "$log" >&2
    exit 1
  }
  sleep 0.5
done
[[ -n "$ready" ]] || {
  echo "ERROR: /readyz never came up — the informers did not finish listing" >&2
  tail -20 "$log" >&2
  exit 1
}
echo "▸ ready — every source's informers have listed"

if ((SOAK_MCP)); then
  for _ in $(seq 1 50); do
    mcp_sid="$(curl -sS -m 5 -X POST "http://$mcp_addr" \
      -H 'Content-Type: application/json' \
      -H 'Accept: application/json, text/event-stream' \
      -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"lookout-soak","version":"0"}}}' \
      -D - -o /dev/null 2>/dev/null | grep -i '^Mcp-Session-Id:' | tr -d '\r' | awk '{print $2}' || true)"
    [[ -n "$mcp_sid" ]] && break
    kill -0 "$mcp_pid" 2>/dev/null || {
      echo "ERROR: lookout mcp exited during startup:" >&2
      tail -20 "$mcp_log" >&2
      exit 1
    }
    sleep 0.2
  done
  [[ -n "$mcp_sid" ]] || {
    echo "ERROR: lookout mcp on $mcp_addr never returned a session id" >&2
    tail -20 "$mcp_log" >&2
    exit 1
  }
  curl -sS -m 10 -X POST "http://$mcp_addr" \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' \
    -H "Mcp-Session-Id: $mcp_sid" \
    -d '{"jsonrpc":"2.0","method":"notifications/initialized"}' >/dev/null 2>&1 || true
  echo "▸ mcp server pid $mcp_pid on $mcp_addr (session $mcp_sid)"
fi

# ---- churn for the duration ----------------------------------------------

secs="$(awk -v h="$HOURS" 'BEGIN { printf "%d", h * 3600 }')"
echo "▸ soaking for ${HOURS} h (${secs}s), sampling every ${SAMPLE}s"

churn_pid=""
if ((CHURN > 0)); then
  echo "▸ churning: ${CHURN} parallel rollout drivers, for the whole soak"
  fleet_churn "$secs" "$CHURN" &
  churn_pid=$!
fi

# ---- sample & background posture/MCP rounds -------------------------------

mkdir -p "$(dirname "$SAMPLES")"
: >"$SAMPLES"
((SOAK_MCP)) && : >"$MCP_SAMPLES"
((SOAK_AUDIT || SOAK_MCP)) && : >"$POSTURE_SAMPLES"

OBJECTS="$STATE_DIR/soak-objects"
count_objects_once() {
  local n
  n="$(kubectl get pods,replicasets -A -l "$FLEET_LABEL" \
    --no-headers 2>/dev/null | grep -c . || true)"
  ((n > 0)) && echo "$n" >"$OBJECTS"
  return 0
}
echo "▸ counting the fleet…"
count_objects_once
echo "▸ fleet control: $(cat "$OBJECTS") objects"
( while true; do sleep "$SAMPLE"; count_objects_once; done ) &

started="$(date +%s)"

# mcp_call_tool <tool_name> <args_json> — returns 0 if the MCP server
# returns a non-empty response without transport error.
mcp_call_tool() {
  local tool="$1" args="$2" resp
  resp="$(curl -sS -m 120 -X POST "http://$mcp_addr" \
    -H 'Content-Type: application/json' \
    -H 'Accept: application/json, text/event-stream' \
    -H "Mcp-Session-Id: $mcp_sid" \
    -d "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"$tool\",\"arguments\":$args}}" \
    2>/dev/null | sed -n 's/^data: //p' || true)"
  [[ "$resp" == *'"result"'* && "$resp" != *'"isError":true'* ]]
}

# run_posture_mcp_round — one cycle of `audit all -A | findings diff`
# plus a representative batch of MCP tool calls against the live cluster.
run_posture_mcp_round() {
  local el="$(($(date +%s) - started))"
  local arc=0 drc=0 mrc=0 scanned=0 findings=0 fnew=0 ongoing=0 resolved=0 store_kb=0
  local rep="$STATE_DIR/soak-audit-report.logfmt" diff_out=""

  if ((SOAK_AUDIT)); then
    "$bin" audit all -A --exemptions="$soak_exemptions" --timeout=120s >"$rep" 2>/dev/null && arc=0 || arc=$?
    local sum
    sum="$(grep -E '(^| )scanned=' "$rep" 2>/dev/null | tail -n1 || true)"
    scanned="$(grep -oE 'scanned=[0-9]+' <<<"$sum" | head -n1 | cut -d= -f2 || echo 0)"
    findings="$(grep -oE 'findings=[0-9]+' <<<"$sum" | head -n1 | cut -d= -f2 || echo 0)"
    [[ -n "$scanned" ]] || scanned=0
    [[ -n "$findings" ]] || findings=0

    diff_out="$("$bin" findings diff --store="$soak_store" --report="$rep" --cluster=kwok-soak --timeout=60s 2>/dev/null)" && drc=0 || drc=$?
    local dsum
    dsum="$(grep -E '(^| )scanned=' <<<"$diff_out" | tail -n1 || true)"
    fnew="$(grep -oE 'new=[0-9]+' <<<"$dsum" | head -n1 | cut -d= -f2 || echo 0)"
    ongoing="$(grep -oE 'ongoing=[0-9]+' <<<"$dsum" | head -n1 | cut -d= -f2 || echo 0)"
    resolved="$(grep -oE 'resolved=[0-9]+' <<<"$dsum" | head -n1 | cut -d= -f2 || echo 0)"
    [[ -n "$fnew" ]] || fnew=0
    [[ -n "$ongoing" ]] || ongoing=0
    [[ -n "$resolved" ]] || resolved=0

    local f bytes=0 b
    for f in "$soak_store" "$soak_store-wal" "$soak_store-shm"; do
      if [[ -f "$f" ]]; then
        b="$(stat -c '%s' "$f" 2>/dev/null || echo 0)"
        bytes=$((bytes + b))
      fi
    done
    store_kb="$(awk -v b="$bytes" 'BEGIN { printf "%.1f", b / 1024 }')"
  fi

  if ((SOAK_MCP)); then
    mcp_call_tool "k8s_health" '{"all_namespaces":true}' || mrc=1
    mcp_call_tool "k8s_triage_list" '{"all_namespaces":true}' || mrc=1
    mcp_call_tool "k8s_audit_all" '{"all_namespaces":true}' || mrc=1
    mcp_call_tool "k8s_audit_namespaces" '{"all_namespaces":true}' || mrc=1
    mcp_call_tool "k8s_audit_computeclass" '{"all_namespaces":true}' || mrc=1
    mcp_call_tool "k8s_audit_ai" '{"all_namespaces":true}' || mrc=1
    mcp_call_tool "k8s_audit_policy" '{}' || mrc=1
  fi

  printf "%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%s\n" \
    "$el" "$arc" "$drc" "$mrc" "$scanned" "$findings" "$fnew" "$ongoing" "$resolved" "$store_kb" >>"$POSTURE_SAMPLES"
  return 0
}

posture_pid=""
if ((SOAK_AUDIT || SOAK_MCP)); then
  echo "▸ posture & MCP driver: running every ${AUDIT_INTERVAL}s (audit=${SOAK_AUDIT}, mcp=${SOAK_MCP})"
  (
    while true; do
      run_posture_mcp_round || true
      sleep "$AUDIT_INTERVAL"
    done
  ) &
  posture_pid=$!
fi

while true; do
  now="$(date +%s)"
  elapsed=$((now - started))
  ((elapsed < secs)) || break
  kill -0 "$pid" 2>/dev/null || { echo "ERROR: the sentinel died at ${elapsed}s" >&2; break; }
  if ((SOAK_MCP)); then
    kill -0 "$mcp_pid" 2>/dev/null || { echo "ERROR: lookout mcp died at ${elapsed}s" >&2; break; }
  fi

  rss_kb="$(awk '/^VmRSS:/ { print $2 }' "/proc/$pid/status" 2>/dev/null || echo 0)"
  heap_b="$(curl -fsS "http://$addr/metrics" 2>/dev/null |
    awk '/^go_memstats_heap_inuse_bytes /{ v = $2 } END { print v + 0 }' || true)"
  [[ -n "$heap_b" ]] || heap_b=0
  objs="$(cat "$OBJECTS" 2>/dev/null || echo 0)"

  awk -v e="$elapsed" -v r="$rss_kb" -v h="$heap_b" -v o="$objs" \
    'BEGIN { printf "%d\t%.1f\t%.1f\t%d\n", e, r / 1024, h / 1048576, o }' >>"$SAMPLES"

  if ((SOAK_MCP)); then
    mcp_rss_kb="$(awk '/^VmRSS:/ { print $2 }' "/proc/$mcp_pid/status" 2>/dev/null || echo 0)"
    awk -v e="$elapsed" -v r="$mcp_rss_kb" -v o="$objs" \
      'BEGIN { printf "%d\t%.1f\t0.0\t%d\n", e, r / 1024, o }' >>"$MCP_SAMPLES"
  fi

  if ((elapsed % 600 < SAMPLE)); then
    awk -v e="$elapsed" -v r="$rss_kb" -v h="$heap_b" \
      'BEGIN { printf "  %5.1f h   RSS %7.1f MiB   heap %7.1f MiB\n",
        e / 3600, r / 1024, h / 1048576 }'
  fi
  sleep "$SAMPLE"
done

for bg in "$churn_pid" "$posture_pid"; do
  if [[ -n "$bg" ]]; then
    kill "$bg" 2>/dev/null || true
    wait "$bg" 2>/dev/null || true
  fi
done

report
