. "$(dirname "$0")/../../lib.sh"
require_examples_context
require_kwok_installed

NS=kwok-scenario-pdb
GRIDLOCKED=3
HEALTHY=9

stub_mark kwok-pdb-gridlock

echo "▸ $HEALTHY sound PDBs and $GRIDLOCKED gridlocked ones in $NS"

emit() {
  cat <<EOF
apiVersion: v1
kind: Namespace
metadata:
  name: ${NS}
  labels:
    app.kubernetes.io/managed-by: lookout-kwok-scale
EOF
  # A gridlocked PDB is minAvailable == replicas: the eviction API can
  # never allow a disruption, so a drain of whatever node holds one of
  # these pods hangs forever.
  local i
  for ((i = 0; i < GRIDLOCKED; i++)); do
    emit_pair "$(printf 'stuck-%02d' "$i")" 2 2
  done
  # The haystack. Same shape, one spare replica of headroom, and the
  # check must stay silent about every one of them.
  for ((i = 0; i < HEALTHY; i++)); do
    emit_pair "$(printf 'ok-%02d' "$i")" 3 1
  done
}

emit_pair() {
  local name="$1" replicas="$2" min_available="$3"
  cat <<EOF
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${name}
  namespace: ${NS}
spec:
  replicas: ${replicas}
  selector:
    matchLabels:
      app: ${name}
  template:
    metadata:
      labels:
        app: ${name}
    spec:
      nodeSelector:
        type: kwok
      tolerations:
      - key: ${FAKE_NODE_TAINT_KEY}
        operator: Equal
        value: ${FAKE_NODE_ANNOTATION_VALUE}
        effect: NoSchedule
      containers:
      - name: app
        image: registry.k8s.io/pause:3.9
        resources:
          requests:
            cpu: 10m
            memory: 16Mi
---
apiVersion: policy/v1
kind: PodDisruptionBudget
metadata:
  name: ${name}
  namespace: ${NS}
spec:
  minAvailable: ${min_available}
  selector:
    matchLabels:
      app: ${name}
EOF
}

emit | kubectl apply -f -
kubectl -n "$NS" wait --for=condition=Available deploy --all --timeout=180s >/dev/null
echo "  ✓ $((GRIDLOCKED + HEALTHY)) deployments up; $GRIDLOCKED PDBs at disruptionsAllowed=0"
