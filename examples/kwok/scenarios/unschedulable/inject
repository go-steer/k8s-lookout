. "$(dirname "$0")/../../lib.sh"
require_examples_context
require_kwok_installed

NS=kwok-scenario-unschedulable
SPREAD_NODES=3
SPREAD_REPLICAS=8

stub_mark kwok-unschedulable

# The anti-affinity pool is labelled, not inherited from a zone, so the
# expected split is SPREAD_NODES placed / the rest pending no matter how
# large the fleet is.
echo "▸ labelling $SPREAD_NODES fake nodes as the anti-affinity pool"
mapfile -t pool < <(fake_nodes | head -n "$SPREAD_NODES")
if ((${#pool[@]} < SPREAD_NODES)); then
  echo "ERROR: need at least $SPREAD_NODES fake nodes, found ${#pool[@]}." >&2
  echo "Run examples/kwok/scale-up first." >&2
  exit 1
fi
for n in "${pool[@]}"; do
  kubectl label node "$n" lookout.examples/kwok-scenario=spread --overwrite >/dev/null
done

echo "▸ deploying three shapes the scheduler must reject differently"
sed -e "s|@NS@|${NS}|g" \
  -e "s|@SPREAD_NODES@|${SPREAD_NODES}|g" \
  -e "s|@SPREAD_REPLICAS@|${SPREAD_REPLICAS}|g" \
  "$(dirname "$0")/manifests.yaml" | kubectl apply -f -

echo "  expected: 3 zone-orphan + 2 oversized + $((SPREAD_REPLICAS - SPREAD_NODES)) spread = $((5 + SPREAD_REPLICAS - SPREAD_NODES)) Pending"
