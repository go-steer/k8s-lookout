. "$(dirname "$0")/../../lib.sh"
require_examples_context
require_kwok_installed

NS=kwok-scenario-logs
REPLICAS="${LOGS_REPLICAS:-24}"
dir="$(kwok_logs_dir)"

echo "▸ authoring two container log streams"

# The app stream: a handful of ordinary templates that only differ in
# their variable tokens, then a Java exception with a Caused by.
{
  cri_log stdout 900 'starting order-service build=1a2b3c9'
  cri_log stdout 890 'connected to postgres at db-0.prod.svc.cluster.local:5432'
  for i in 1 2 3 4 5 6 7 8; do
    cri_log stdout $((800 - i * 20)) "handled GET /api/orders/${i}9${i} in $((7 + i))ms"
  done
  cri_log stderr 600 'java.lang.IllegalStateException: connection pool exhausted'
  cri_log stderr 600 "$(printf '\tat com.example.db.Pool.acquire(Pool.java:214)')"
  cri_log stderr 600 "$(printf '\tat com.example.api.OrderService.load(OrderService.java:88)')"
  cri_log stderr 600 "$(printf '\tat com.example.api.OrderController.get(OrderController.java:41)')"
  cri_log stderr 600 'Caused by: java.net.SocketTimeoutException: connect timed out'
  cri_log stderr 600 "$(printf '\tat java.base/java.net.Socket.connect(Socket.java:633)')"
  cri_log stdout 120 'shedding load: queue depth 412'
} >"$dir/${NS}-app.log"

# The gateway stream: an access log whose largest population by far is
# the kubelet's own probes, plus a Go panic.
{
  for i in $(seq 1 40); do
    cri_log stdout $((900 - i * 20)) \
      "10.244.0.1 - - \"GET /healthz HTTP/1.1\" 200 2 \"kube-probe/1.34\""
    cri_log stdout $((899 - i * 20)) \
      "10.244.3.7 - - \"GET /api/orders/${i}0${i} HTTP/1.1\" 200 $((300 + i))"
  done
  cri_log stderr 300 'panic: runtime error: invalid memory address or nil pointer dereference'
  cri_log stderr 300 '[signal SIGSEGV: segmentation violation code=0x1 addr=0x0 pc=0x4a1b2c]'
  cri_log stderr 300 'goroutine 42 [running]:'
  cri_log stderr 300 'main.(*Server).handle(0xc000123456, 0x0)'
  cri_log stderr 300 "$(printf '\t/src/server.go:118 +0x2c')"
  cri_log stderr 300 'main.(*Server).ServeHTTP(0xc000123456, 0xc00019a000)'
  cri_log stderr 300 "$(printf '\t/src/server.go:71 +0x9a')"
  cri_log stderr 300 'net/http.serverHandler.ServeHTTP(0xc0000a4000, 0xc00019a000)'
  cri_log stderr 300 "$(printf '\t/usr/local/go/src/net/http/server.go:2938 +0x30c')"
  cri_log stderr 300 'created by net/http.(*Server).Serve'
} >"$dir/${NS}-gateway.log"

kwok_logs_publish
echo "  ✓ published $(wc -l <"$dir/${NS}-app.log") + $(wc -l <"$dir/${NS}-gateway.log") lines"

echo "▸ deploying $REPLICAS fake pods that serve them"
sed -e "s|@NS@|${NS}|g" -e "s|@REPLICAS@|${REPLICAS}|g" -e "s|@MOUNT@|${KWOK_LOGS_MOUNT}|g" \
  "$(dirname "$0")/manifests.yaml" | kubectl apply -f -

kubectl -n "$NS" rollout status deploy/noisy --timeout=180s

# The controller reads the log files off its own filesystem, and the
# kubelet reprojects a changed ConfigMap on its sync period — measured
# at ~30s here, not instantly. Wait for the files to actually appear
# rather than letting `verify` interpret "not yet mounted" as "lookout
# found nothing": that failure is GREEN, and green failures are the
# expensive kind.
_streams_mounted() {
  local pod
  pod="$(kubectl -n kube-system get pods -l app=kwok-controller \
    -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)" || return 1
  [[ -n "$pod" ]] || return 1
  kubectl -n kube-system exec "$pod" -- ls "$KWOK_LOGS_MOUNT" 2>/dev/null |
    grep -q "^${NS}-gateway.log$"
}
await 180 "log streams projected into the kwok controller" _streams_mounted
