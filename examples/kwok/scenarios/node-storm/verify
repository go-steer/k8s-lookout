set -euo pipefail
. "$(dirname "$0")/../../lib.sh"
require_examples_context

COUNT="$(cat "$STATE_DIR/node-storm.count" 2>/dev/null || echo 30)"

echo "▸ verify node-storm ($COUNT nodes)"

# ---- the fixture -----------------------------------------------------

_nodes_down() {
  local down
  down="$(kubectl get nodes -l "$FAKE_NODE_LABEL" \
    -o jsonpath='{range .items[*]}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' \
    2>/dev/null | grep -c '^Unknown$' || true)"
  ((down >= COUNT))
}
await 300 "$COUNT fake nodes report Ready=Unknown" _nodes_down

# ---- detection: every dead node reaches the wire ---------------------

# The floor: at this scale the sentinel must not drop node failures on
# the floor, whatever it decides to do about grouping them.
await_inject node-storm 300 'kind=objectstate.node_notready'

# Count nodes named as the SUBJECT of a node_notready inject, not every
# node the capture happens to mention: the pod incidents and the storms
# name their nodes too, so a loose match here would pass on the healthy
# ones and assert nothing.
_all_nodes_on_wire() {
  local named
  named="$(stub_since node-storm | grep 'kind=objectstate.node_notready' \
    | grep -o '\\"name\\":\\"kwok-node-[0-9]*' | sort -u | wc -l || true)"
  ((named >= COUNT))
}
await 300 "all $COUNT failed nodes named on the wire" _all_nodes_on_wire

# ---- the read path summarizes the same event in one line -------------

# Worth asserting next to the wire check, because the two disagree (see
# the soft check below): `health` rolls the whole outage into a single
# nodes-category line carrying the count.
await_finding 300 "category=nodes status=degraded total=$COUNT" -- health

# ---- the pod fallout DOES correlate ----------------------------------

# Eviction starts on the real tolerationSeconds (~5 minutes), and the
# pods that go with the nodes are what §7.5 was built for: they share
# declared ancestors — their Deployment, their Namespace — so they form
# storms instead of one session each. This half works, and locking it
# down is what keeps the soft check below honest: the correlator is not
# broken, it just has no key for nodes.
_storm_formed() {
  local out
  out="$(stub_since node-storm)"
  grep -q 'INJECT .* kind=storm ' <<<"$out"
}
if await 600 "the evicted pods form at least one storm session" _storm_formed; then
  storms="$(stub_since node-storm | grep -c 'INJECT .* kind=storm ' || true)"
  echo "    wire: $storms storm session(s) from the pod fallout"
fi

# ---- the NODES correlate too (#334) ----------------------------------

# This is the claim only a fleet can make, and it was the answer that
# needed fixing: before #334 a Node incident's only blast-radius key
# was its own Node, so thirty nodes dying in one second opened thirty
# sessions while `lookout health` said it in one line.
#
# scale-up labels every fake node topology.kubernetes.io/zone=zone-N
# for N in 0..2 and node-fail takes them in name order, so a 30-node
# outage spans all three zones and the ZONE key is what forms here —
# one storm per zone, the modelled answer. The cluster fallback
# (key_source=simultaneity) is the unlabelled-fleet path and is covered
# by unit tests, not by this drill.
echo "▸ the node failures correlate with each other (#334)"

# Each zone's storm names it, so counting distinct Zone ancestors is a
# tighter assertion than counting storms: it proves the key is the
# zone and not something that happens to group.
_zone_storms() {
  local zones
  zones="$(stub_since node-storm | grep 'INJECT .* kind=storm ' \
    | grep -o 'ancestor_kind\\":\\"Zone\\",\\"ancestor_name\\":\\"zone-[0-9]*' \
    | sort -u | wc -l || true)"
  ((zones >= 3))
}
await 300 "the failed nodes group by zone, not one session each" _zone_storms

# The reduction itself. Three zone storms plus the pod fallout's own
# storms and their member sessions is well under COUNT; one session per
# node is the regression this guards.
_nodes_correlate() {
  local sessions
  sessions="$(stub_since node-storm | grep -c 'SESSION-CREATE' || true)"
  ((sessions > 0 && sessions < COUNT / 2))
}
await 60 "fewer than $((COUNT / 2)) sessions for one $COUNT-node outage" _nodes_correlate
sessions="$(stub_since node-storm | grep -c 'SESSION-CREATE' || true)"
echo "    wire: $sessions sessions opened for one $COUNT-node outage"
