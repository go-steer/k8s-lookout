# inject → verify → revert for the scenarios that need a FLEET.
#
# The same contract as examples/e2e, one tier down the fidelity scale.
# The default set asserts the READ PATH only — not because the wire
# would not work, but because what makes those scenarios worth running
# is a claim about hundreds of objects, and every one of those claims is
# answerable from a read. They need no sentinel deployed.
#
# node-storm is the exception and is therefore opt-in: its whole claim
# is about what the sentinel SENDS when a third of the fleet dies at
# once, so it needs examples/sentinel/up, and it spends most of ten
# minutes letting the fleet go quiet before it marks the wire and then
# waiting on the real recovery window. Run it by name.
#
# Usage:
#   examples/kwok/e2e                        # the default set, ordered
#   examples/kwok/e2e logs unschedulable
#   examples/kwok/e2e node-storm             # needs the sentinel
#
# Prereqs: examples/kind/up, examples/kwok/up, examples/kwok/scale-up.

. "$(dirname "$0")/lib.sh"
require_examples_context
require_kwok_installed

# node-storm is deliberately absent — see the header.
DEFAULT_SCENARIOS=(
  logs
  unschedulable
  pdb-gridlock
  endpoints-empty
)

scenarios=("$@")
if ((${#scenarios[@]} == 0)); then
  scenarios=("${DEFAULT_SCENARIOS[@]}")
fi
for s in "${scenarios[@]}"; do
  if [[ ! -x "$(kwok_root)/scenarios/$s/inject" ]]; then
    echo "ERROR: unknown scenario '$s'. Available:" >&2
    ls "$(kwok_root)/scenarios" | sed 's/^/  /' >&2
    exit 2
  fi
done

echo "▸ preflight"
nodes="$(fake_node_count)"
if ((nodes < 10)); then
  echo "ERROR: only $nodes fake nodes. These scenarios make claims about a" >&2
  echo "fleet — run examples/kwok/scale-up first (100 is plenty)." >&2
  exit 1
fi
echo "  ✓ $nodes fake nodes"
echo "  ✓ fake kubelet endpoint: $(kwok_host_ip):10247"
echo "  ✓ lookout binary: $(lookout_bin)"

declare -A results
failed=0
for s in "${scenarios[@]}"; do
  dir="$(kwok_root)/scenarios/$s"
  printf '\n\033[1m════ kwok scenario: %s ════\033[0m\n' "$s"
  ok=true
  if ! "$dir/inject"; then
    ok=false
    echo "✗ $s: inject failed" >&2
  elif ! "$dir/verify"; then
    ok=false
    echo "✗ $s: verify failed" >&2
  fi
  if ! "$dir/revert"; then
    ok=false
    echo "✗ $s: revert failed — cluster may need manual cleanup" >&2
  fi
  if $ok; then
    results[$s]=PASS
  else
    results[$s]=FAIL
    failed=$((failed + 1))
  fi
done

printf '\n\033[1m════ kwok e2e summary ════\033[0m\n'
for s in "${scenarios[@]}"; do
  printf '  %-18s %s\n' "$s" "${results[$s]}"
done
if ((failed > 0)); then
  echo
  echo "$failed scenario(s) failed." >&2
  exit 1
fi
echo
echo "All ${#scenarios[@]} scenario(s) passed."
