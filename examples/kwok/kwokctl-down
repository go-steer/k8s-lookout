# Tear down the standalone kwokctl cluster created by
# examples/kwok/kwokctl-up and remove its isolated kubeconfig
# ($KWOKCTL_KUBECONFIG), leaving ~/.kube/config untouched.

set -euo pipefail
. "$(dirname "$0")/lib.sh"

kwokctl="$(kwokctl_bin)"

if "$kwokctl" get clusters 2>/dev/null | grep -Fxq "$CLUSTER_NAME"; then
  echo "▸ deleting kwokctl cluster '$CLUSTER_NAME'"
  "$kwokctl" delete cluster --name "$CLUSTER_NAME"
else
  echo "▸ no kwokctl cluster named '$CLUSTER_NAME' found"
fi

if [[ -f "$KWOKCTL_KUBECONFIG" ]]; then
  rm -f "$KWOKCTL_KUBECONFIG"
  echo "  ✓ removed $KWOKCTL_KUBECONFIG"
fi
