# Remove the whole kwok layer: the synthetic fleet, the fake nodes, the
# Stages and the controller. The kind cluster, the sentinel and the
# demo app are left running and untouched — the point of this layer is
# that it can be taken away without disturbing anything under it.

. "$(dirname "$0")/lib.sh"
require_examples_context

# Fleet and nodes first: with the controller gone there is nothing left
# to complete a fake pod's deletion.
"$(kwok_root)/scale-down"

echo "▸ removing kwok Stages and controller"
kubectl delete -f "$(kwok_root)/stages/" --ignore-not-found >/dev/null
kubectl delete -f "${KWOK_RELEASE_URL}/metrics-usage.yaml" --ignore-not-found >/dev/null 2>&1 || true
kubectl delete -f "${KWOK_RELEASE_URL}/stage-fast.yaml" --ignore-not-found >/dev/null
kubectl delete -f "${KWOK_RELEASE_URL}/kwok.yaml" --ignore-not-found >/dev/null

echo
echo "kwok removed. The real cluster is unchanged:"
kubectl get nodes
