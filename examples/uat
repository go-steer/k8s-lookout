# CLI UAT driver — docs/testing/cli-uat.md.
#
# examples/e2e asks "does the sentinel fire the right signal when a
# workload breaks?" (the watch path). This asks the other half: "does
# every read-path command return correct, well-shaped, secret-safe
# output?" It reuses the same cluster, demo app, context guard and
# binary resolution; it does not deploy anything and, unlike the
# scenarios, it does not break workloads — the fixtures it needs live
# in examples/scenarios/ and are injected by name.
#
# Usage:
#   examples/uat                  # every case this tier can run
#   examples/uat contract         # one case file
#   UAT_TIER=T1 examples/uat      # allow the metrics-server cases too
#
# Prereqs: examples/kind/up and `kubectl apply -f examples/workloads/`.
# A sentinel is NOT required — every command here reads the cluster
# directly through the current kubeconfig. Exit 0 only if every check
# passed; a skipped case is reported and does not fail the run.

. "$(dirname "$0")/lib.sh"
. "$(dirname "$0")/uat-lib.sh"
. "$(dirname "$0")/uat-invocations.sh"
require_examples_context

UAT_CASES_DIR="$(examples_root)/uat-cases"

cases=("$@")
if ((${#cases[@]} == 0)); then
  mapfile -t cases < <(cd "$UAT_CASES_DIR" && ls ./*.sh | sed 's|^\./||; s|^[0-9]*-||; s|\.sh$||')
fi

case_file() {
  local f
  for f in "$UAT_CASES_DIR"/*"$1".sh; do
    [[ -f "$f" ]] && {
      echo "$f"
      return 0
    }
  done
  return 1
}

for c in "${cases[@]}"; do
  if ! case_file "$c" >/dev/null; then
    echo "ERROR: unknown case '$c'. Available:" >&2
    (cd "$UAT_CASES_DIR" && ls ./*.sh | sed 's|^\./||; s|^[0-9]*-||; s|\.sh$||; s|^|  |') >&2
    exit 2
  fi
done

echo "▸ preflight"
if ! kubectl get namespace "$DEMO_NS" >/dev/null 2>&1; then
  echo "▸ demo workloads missing — applying examples/workloads/"
  kubectl apply -f "$(examples_root)/workloads/"
fi
kubectl -n "$DEMO_NS" wait --for=condition=Available deploy --all --timeout=180s >/dev/null
echo "  ✓ demo workloads ready"
echo "  ✓ lookout binary: $(lookout_bin)"
echo "  ✓ tier: $UAT_TIER"

# Scratch space for the stores, reports and exemption files the cases
# build. Removed on exit including on failure — a UAT run must not
# leave a SQLite store behind for the next one to read stale state from.
UAT_WORKDIR="$(mktemp -d "${TMPDIR:-/tmp}/lookout-uat.XXXXXX")"
trap 'rm -rf "$UAT_WORKDIR"' EXIT
echo "  ✓ workdir: $UAT_WORKDIR"

for c in "${cases[@]}"; do
  f="$(case_file "$c")"
  printf '\n\033[1m════ uat case: %s ════\033[0m\n' "$c"
  # shellcheck source=/dev/null
  . "$f"
  fn="uat_case_${c//-/_}"
  if ! declare -F "$fn" >/dev/null; then
    uat_bad "$c: case file defines no $fn"
    continue
  fi
  "$fn" || true
done

printf '\n\033[1m════ uat summary ════\033[0m\n'
printf '  %d passed, %d failed, %d skipped\n' "$UAT_PASS" "$UAT_FAIL" "$UAT_SKIP"

if ((UAT_SKIP > 0)); then
  printf '\n  skipped (tier %s):\n' "$UAT_TIER"
  printf '    %s\n' "${UAT_SKIPS[@]}"
fi

if ((UAT_FAIL > 0)); then
  printf '\n  \033[31mfailed:\033[0m\n' >&2
  printf '    %s\n' "${UAT_FAILURES[@]}" >&2
  exit 1
fi
echo
echo "All $UAT_PASS check(s) passed."
