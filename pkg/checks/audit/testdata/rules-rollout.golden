kind=audit.rollout_drops_traffic severity=warning namespace=prod kind_of_object=DaemonSet name=node-agent reason=NoPreStopOnServingContainer message="1 Service routes to this workload and 1 of its 1 serving container has no preStop hook: on every rollout, drain or scale-down the kubelet sends SIGTERM while endpoint removal is still propagating, and in-flight requests are answered with connection resets — a preStop sleep of a few seconds is the only thing in the pod lifecycle that delays SIGTERM" fingerprint=sha256:e882d8c72263e0648d5ae495c7160cbed23691ef078d011f9b86322d1e420199 containers=1 container_names=agent total_containers=1 services=1 service_names=node-agent termination_grace=30s
kind=audit.rollout_drops_traffic severity=warning namespace=prod kind_of_object=Deployment name=api reason=NoPreStopOnServingContainer message="1 Service routes to this workload and 1 of its 1 serving container has no preStop hook: on every rollout, drain or scale-down the kubelet sends SIGTERM while endpoint removal is still propagating, and in-flight requests are answered with connection resets — a preStop sleep of a few seconds is the only thing in the pod lifecycle that delays SIGTERM" fingerprint=sha256:ff7979a9f176a8284ef9d12d2330b839d5e0d47873789c5abea050ad17f1b8bf containers=1 container_names=api total_containers=1 services=1 service_names=api termination_grace=30s
kind=audit.liveness_preempts_readiness severity=info namespace=prod kind_of_object=Deployment name=api reason=LivenessFiresFirst message="liveness and readiness probe the same handler and liveness gives up first on 1 of 1 containers: the kubelet restarts the container before readiness can take it out of the Service, so every slow start or dependency blip is a restart with traffic still routed to it — api: httpGet is both probes; liveness fails at ~30s, readiness at ~30s" fingerprint=sha256:570b015b76b3b5d5cf3eea5bfba59d46cf277c2c05f0fd45ca23ee55ef92a038 containers=1 container_names=api total_containers=1
kind=audit.recreate_strategy severity=warning namespace=prod kind_of_object=Deployment name=batch reason=RecreateServiceBacked message="strategy.type=Recreate with replicas=3 and 1 Service routing to it: the controller may take every pod down before the first replacement is Ready, so each rollout is an outage lasting an image pull plus a cold start — invisible afterwards, because the Deployment reports Available between rollouts" fingerprint=sha256:6d4993cd78f5c6e7b471c7f62a751377c15cc56e07a2212e132efe6857b3e6c0 replicas=3 strategy="strategy.type=Recreate" services=1 service_names=batch
