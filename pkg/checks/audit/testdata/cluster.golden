kind=audit.public_control_plane severity=info kind_of_object=Cluster name=prod-east reason=AuthorizedNetworksAllowProviderCIDRs message="the authorized-network allow-list names 2 ranges and additionally admits the provider's own public ranges: anyone who can rent a VM from the provider is inside the allow-list. On by default, so it is reported as posture rather than as a defect" fingerprint=sha256:659aaeb8098a9af973a7842fdae66c10db73968c110b28afa0257195353230dd endpoint=203.0.113.10 authorized_networks=2 authorized_network_cidrs=198.51.100.0/24,192.0.2.0/24 gcp_public_cidrs=true
kind=audit.legacy_metadata severity=warning kind_of_object=NodePool name=legacy-pool reason=LegacyMetadataEndpoints message="the node pool still serves the legacy metadata endpoints: they answer without the header the current endpoint requires, so any request a pod can be tricked into making — a URL in a webhook field, an SSRF in a proxy — reaches the node's credentials" fingerprint=sha256:897c19e60c36f2e96c0d4031546c5ba406a96a7646558b3c44b541841f5f072b cluster=prod-east disable_legacy_endpoints=enabled
