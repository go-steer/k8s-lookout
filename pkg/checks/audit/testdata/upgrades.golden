kind=audit.upgrade_blocked severity=warning kind_of_object=Cluster name=prod-east reason=MaintenanceExclusionBlocksPatches message="maintenance exclusion \"retail-freeze\" is in force and blocks ALL upgrades until 2026-10-14T12:00:00Z, security patches included: for as long as it stands the provider will not fix this cluster even when it has the fix" fingerprint=sha256:220a11183f8fb23208a3d15b618b4e40736c3be98622242ff282e6320e5c5b9b exclusion=retail-freeze scope=all-upgrades ends=2026-10-14T12:00:00Z days_remaining=60
kind=audit.version_behind severity=warning kind_of_object=Cluster name=prod-east reason=ControlPlaneMinorBehind message="the control plane runs 1.29.7-gke.1104000 and the provider publishes 1.30.6-gke.1125000 for this cluster: a whole release line of fixes has not been applied, and every minor the cluster falls behind is one the provider will eventually stop supporting it on" fingerprint=sha256:7bc0acc62cb062c5482b6b09a996e7b06af36b898eab7999503493fff727cbbb version=1.29.7-gke.1104000 target_version=1.30.6-gke.1125000 channel=regular minor_versions_behind=1
kind=audit.upgrade_blocked severity=warning kind_of_object=NodePool name=docker-pool reason=StaleNodeImageType message="the pool runs the COS node image, which is built around the Docker runtime Kubernetes removed in 1.24: the pool cannot be upgraded past the last version that still carried the shim, so it is not a version gap that any upgrade setting will close — the image type has to change" fingerprint=sha256:af1527960f1009c793864c37a5944ad48cabca043e38a027cf22b5f03bbead9c cluster=prod-east image_type=COS version=1.29.7-gke.1104000
kind=audit.upgrade_unmanaged severity=warning kind_of_object=NodePool name=stale-pool reason=NodeAutoRepairOff message="node auto-repair is off for this pool: a node that stops reporting healthy stays in the pool as it is, which is how a half-finished upgrade leaves one broken node behind and nothing takes it out" fingerprint=sha256:25d93b02c8761bebaddba5d881ed4b2724d5e9f1b838107627597828096d9190 cluster=prod-east
kind=audit.upgrade_unmanaged severity=warning kind_of_object=NodePool name=stale-pool reason=NodeAutoUpgradeOff message="node auto-upgrade is off for this pool: its nodes stay on the version they were created with until a human recreates them, so the node OS, the kubelet and the container runtime accumulate every fix nobody applies by hand" fingerprint=sha256:900bdf64057e71f235bbc09197d340ad1108efcd88b8c194acaf3173aa313d58 cluster=prod-east version=1.27.11-gke.1062000
kind=audit.version_behind severity=warning kind_of_object=NodePool name=stale-pool reason=NodePoolVersionSkew message="the node pool runs 1.27.11-gke.1062000 against a 1.29.7-gke.1104000 control plane, at the 2-minor version skew the provider supports: the pool works today and stops being a supported configuration the next time the control plane advances, which on a channel-subscribed cluster is not something anyone here schedules" fingerprint=sha256:cc2d63369040d8e503b60f9d7d48dcc85709a6e2b05e85c97bb559d6c81f1ebb cluster=prod-east version=1.27.11-gke.1062000 control_plane_version=1.29.7-gke.1104000 minor_versions_behind=2
