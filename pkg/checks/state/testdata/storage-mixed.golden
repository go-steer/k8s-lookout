kind=storage.no_provisioner severity=warning namespace=prod kind_of_object=PersistentVolumeClaim name=static reason=NoDynamicProvisioner message="claim wants storageclass \"local\", whose provisioner is kubernetes.io/no-provisioner — that class creates nothing, and no volume of it is Available; the claim binds only once somebody pre-provisions one" storage_class=local provisioner=kubernetes.io/no-provisioner binding_mode=Immediate phase=Pending requested=10Gi
