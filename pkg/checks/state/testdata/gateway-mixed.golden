kind=gateway.listener_invalid severity=warning namespace=prod kind_of_object=Gateway name=edge reason=ListenerInvalid message="listener \"https\" is not serving (ResolvedRefs=False, InvalidCertificateRef: secret prod/tls not found) — the gateway's other listeners are unaffected" gateway_class=external listener=https port=443 protocol=HTTPS condition="ResolvedRefs=False"
kind=gateway.missing_class severity=critical namespace=prod kind_of_object=Gateway name=internal reason=MissingGatewayClass message="gateway names gatewayclass \"missing\", which does not exist — no controller claims this gateway, so no address is assigned and no route attaches; the cluster has gatewayclass(es) external,legacy" gateway_class=missing classes=external,legacy
kind=gateway.class_not_accepted severity=critical namespace=prod kind_of_object=Gateway name=old reason=GatewayClassNotAccepted message="gatewayclass \"legacy\" is not accepted by its controller (Waiting: controller not installed) — every gateway of that class is inert" gateway_class=legacy controller=example.net/old-controller condition="Accepted=False"
kind=route.missing_parent severity=critical namespace=prod kind_of_object=HTTPRoute name=orphan reason=MissingGateway message="route attaches to gateway prod/deleted, which does not exist — the route is inert and serves no traffic" gateway=prod/deleted
kind=gateway.not_programmed severity=critical namespace=prod kind_of_object=Gateway name=pending reason=GatewayNotProgrammed message="gateway is accepted but not programmed (Pending: waiting for an address) — the config is valid and no data plane serves it, so traffic reaches nothing" gateway_class=external condition="Programmed=False"
