kind=route.not_accepted severity=critical namespace=prod kind_of_object=HTTPRoute name=refused reason=RouteNotAccepted message="gateway prod/edge refused the attachment (NoMatchingListenerHostname: no listener matches api.example.com) — the route exists and carries no traffic" gateway=prod/edge condition="Accepted=False"
