# Keep the Docker build context down to what the Go build needs:
# go.mod/go.sum + source. Everything below can't affect the binary,
# so excluding it keeps context uploads small and the layer cache
# stable across docs/CI/manifest-only changes.
.git
.github
.claude
.dockerignore
Dockerfile
deploy/
dev/
docs/
*.md
LICENSE
