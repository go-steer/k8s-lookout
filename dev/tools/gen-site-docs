# Regenerate the docs-site Reference section
# (docs/site/src/content/docs/reference/) from the pkg/checks command
# metadata, the sentinel flag/metric inventories, and the
# signal-schema v1 ledger (DESIGN.md §4.4.3: one source of truth,
# generated outward). Re-runnable; output is deterministic. CI
# enforces freshness via internal/sitedoc's drift test — if you
# changed a command's metadata, a watch flag, a metric, or the kind
# ledger, run this and commit the diff.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

go run ./internal/sitedoc/gen -root .
