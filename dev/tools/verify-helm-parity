# Holds the Helm chart to the raw manifests.
#
#   helm template lookout-watch deploy/chart -n agent-triage
#     ==  kustomize build deploy/
#
# Why this exists rather than trust: two independent descriptions of
# the same deployment will diverge — that is not a risk, it is a
# certainty — and the failure mode is silent. deploy/12's ClusterRole
# is already pinned to what the code reads by
# pkg/checks/state/rbac_test.go; a chart not held to the same manifest
# breaks that guarantee for chart users specifically, and nothing else
# would notice. It would keep deploying last quarter's RBAC while every
# test in the tree stayed green.
#
# The comparison is exact, after normalization:
#   - resources sorted by (kind, namespace, name), keys sorted
#   - Helm's own provenance labels dropped (helm.sh/chart,
#     app.kubernetes.io/managed-by, app.kubernetes.io/version) — they
#     are metadata Helm adds to every chart and the manifests correctly
#     do not carry them
#   - `helm template`'s "# Source:" comments dropped
# Everything else — every RBAC rule, every container arg, every probe,
# the security context, the strategy — must match byte for byte.
#
# Also checked: Chart.yaml appVersion against deploy/51's image pin, so
# a release cut that bumps one and forgets the other fails here rather
# than shipping a chart that installs the previous release.
#
# Requires helm and kustomize. Skips with a notice (exit 0) when either
# is missing, so a contributor without them is not blocked. That skip
# is exactly the wrong behaviour in CI — a green job that silently
# checked nothing is worse than no job — so CI sets
# HELM_PARITY_REQUIRE=1, which turns a missing tool into a failure.
#
# Usage:
#   dev/tools/verify-helm-parity            — diff, exit 1 on drift
#   dev/tools/verify-helm-parity --show     — print both renders
#   HELM_PARITY_REQUIRE=1 …                 — missing tool is an error
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

RELEASE_NAME="lookout-watch"
NAMESPACE="agent-triage"
CHART="deploy/chart"

SHOW=0
[[ "${1:-}" == "--show" ]] && SHOW=1

for tool in helm kustomize python3; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    if [[ "${HELM_PARITY_REQUIRE:-0}" == "1" ]]; then
      echo "✗ $tool is not installed, and HELM_PARITY_REQUIRE=1 forbids skipping" >&2
      exit 1
    fi
    echo "▸ skipping helm/kustomize parity: $tool not installed" >&2
    exit 0
  fi
done

# ---- chart version vs appVersion vs the deploy/51 image pin -----------

# Read the rendered manifest, not the file: deploy/51's header comment
# shows a `:<version>-gke` example line, and a grep over the raw source
# happily matches the documentation instead of the deployment.
pinned="$(kustomize build deploy/ | grep -oE '^ +image: ghcr\.io/go-steer/lookout:[^ ]+' | head -1 | cut -d: -f3)"
appversion="$(grep -E '^appVersion:' "$CHART/Chart.yaml" | head -1 | sed -E 's/^appVersion: *"?([^"]*)"?/\1/')"
if [[ "$pinned" != "$appversion" ]]; then
  echo "✗ Chart.yaml appVersion ($appversion) != deploy/51 image pin ($pinned)" >&2
  echo "  The release cut bumps both — see docs/release-process.md." >&2
  exit 1
fi

chartversion="$(grep -E '^version:' "$CHART/Chart.yaml" | head -1 | sed -E 's/^version: *"?([^"]*)"?/\1/')"
if [[ "$chartversion" != "${appversion#v}" ]]; then
  echo "✗ Chart.yaml version ($chartversion) != appVersion without the v (${appversion#v})" >&2
  echo "  The chart version tracks the app version on purpose — see Chart.yaml." >&2
  exit 1
fi

# ---- render both ------------------------------------------------------

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" >"$tmp/chart.raw.yaml"
kustomize build deploy/ >"$tmp/kustomize.raw.yaml"

normalize() {
  python3 - "$1" "$2" <<'PY'
import sys, yaml

src, dst = sys.argv[1], sys.argv[2]

# Labels Helm stamps on everything it renders. They are provenance, not
# configuration, and the hand-written manifests correctly do not carry
# them — so they are the one difference this check forgives.
HELM_META = {
    "helm.sh/chart",
    "app.kubernetes.io/managed-by",
    "app.kubernetes.io/version",
}

docs = []
for doc in yaml.safe_load_all(open(src)):
    if not doc:
        continue
    labels = doc.get("metadata", {}).get("labels")
    if labels:
        for key in HELM_META:
            labels.pop(key, None)
        if not labels:
            del doc["metadata"]["labels"]
    docs.append(doc)

def key(d):
    meta = d.get("metadata", {})
    return (d.get("kind", ""), meta.get("namespace", ""), meta.get("name", ""))

docs.sort(key=key)
with open(dst, "w") as out:
    yaml.safe_dump_all(docs, out, default_flow_style=False, sort_keys=True)
PY
}

normalize "$tmp/chart.raw.yaml" "$tmp/chart.yaml"
normalize "$tmp/kustomize.raw.yaml" "$tmp/kustomize.yaml"

if [[ "$SHOW" -eq 1 ]]; then
  echo "--- kustomize build deploy/ ---"
  cat "$tmp/kustomize.yaml"
  echo "--- helm template $RELEASE_NAME $CHART -n $NAMESPACE ---"
  cat "$tmp/chart.yaml"
fi

if diff -u "$tmp/kustomize.yaml" "$tmp/chart.yaml" >"$tmp/diff"; then
  count="$(grep -c '^kind:' "$tmp/kustomize.yaml" || true)"
  echo "✓ chart matches deploy/ manifests ($count resources)"
else
  echo "✗ the Helm chart and deploy/*.yaml have diverged." >&2
  echo "  Left is kustomize build deploy/ (the source of truth)," >&2
  echo "  right is helm template. Fix deploy/chart/templates/." >&2
  echo >&2
  cat "$tmp/diff" >&2
  exit 1
fi

# ---- the no-secrets variant: rbac.secrets=false == deploy-no-secrets/ --
#
# The one non-default path with a manifest of its own (#149), so it gets
# the same exact diff rather than a render_ok: the overlay and the value
# must drop the same rules and add the same flag.

helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" --set rbac.secrets=false >"$tmp/chart-ns.raw.yaml"
kustomize build deploy-no-secrets/ >"$tmp/kustomize-ns.raw.yaml"
normalize "$tmp/chart-ns.raw.yaml" "$tmp/chart-ns.yaml"
normalize "$tmp/kustomize-ns.raw.yaml" "$tmp/kustomize-ns.yaml"

if diff -u "$tmp/kustomize-ns.yaml" "$tmp/chart-ns.yaml" >"$tmp/diff-ns"; then
  echo "✓ chart with rbac.secrets=false matches deploy-no-secrets/"
else
  echo "✗ helm template --set rbac.secrets=false and deploy-no-secrets/ have diverged." >&2
  echo "  Left is kustomize build deploy-no-secrets/, right is helm template." >&2
  echo >&2
  cat "$tmp/diff-ns" >&2
  exit 1
fi

# The namespace-scoped tier (#407): rbac.scope=namespace must render
# exactly deploy-namespaced/.
helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" --set rbac.scope=namespace >"$tmp/chart-scope.raw.yaml"
kustomize build deploy-namespaced/ >"$tmp/kustomize-scope.raw.yaml"
normalize "$tmp/chart-scope.raw.yaml" "$tmp/chart-scope.yaml"
normalize "$tmp/kustomize-scope.raw.yaml" "$tmp/kustomize-scope.yaml"

if diff -u "$tmp/kustomize-scope.yaml" "$tmp/chart-scope.yaml" >"$tmp/diff-scope"; then
  echo "✓ chart with rbac.scope=namespace matches deploy-namespaced/"
else
  echo "✗ helm template --set rbac.scope=namespace and deploy-namespaced/ have diverged." >&2
  echo "  Left is kustomize build deploy-namespaced/, right is helm template." >&2
  echo >&2
  cat "$tmp/diff-scope" >&2
  exit 1
fi

# ---- the probe variant: rbac.probeFrom=true == deploy-probe/ -----------
#
# The one write grant (#539) and the admission policy that narrows it.
# Exact diff for the same reason as the no-secrets variant: the policy's
# CEL is security-relevant, and two copies of it must not drift.

helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" --set rbac.probeFrom=true >"$tmp/chart-probe.raw.yaml"
kustomize build deploy-probe/ >"$tmp/kustomize-probe.raw.yaml"
normalize "$tmp/chart-probe.raw.yaml" "$tmp/chart-probe.yaml"
normalize "$tmp/kustomize-probe.raw.yaml" "$tmp/kustomize-probe.yaml"

if diff -u "$tmp/kustomize-probe.yaml" "$tmp/chart-probe.yaml" >"$tmp/diff-probe"; then
  echo "✓ chart with rbac.probeFrom=true matches deploy-probe/"
else
  echo "✗ helm template --set rbac.probeFrom=true and deploy-probe/ have diverged." >&2
  echo "  Left is kustomize build deploy-probe/, right is helm template." >&2
  echo >&2
  cat "$tmp/diff-probe" >&2
  exit 1
fi

# Re-namespacing deploy-probe/ must not unhook its admission policy from
# the identity the grant goes to. Kustomize rewrites the binding's
# subject namespace but cannot rewrite a string inside CEL, so the
# policy's identity match must not depend on the namespace. Wrap the
# overlay in a kustomization with another namespace and check that the
# rewritten subject still satisfies the policy's identity condition.
mkdir -p "$tmp/renamespaced"
# kustomize refuses absolute resource paths, so point at the overlay
# relative to the wrapper.
probe_rel="$(python3 -c 'import os, sys; print(os.path.relpath(sys.argv[1], sys.argv[2]))' "$(pwd)/deploy-probe" "$tmp/renamespaced")"
cat >"$tmp/renamespaced/kustomization.yaml" <<EOF
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: team-x-lookout
resources:
  - $probe_rel
EOF
kustomize build "$tmp/renamespaced" >"$tmp/renamespaced.yaml"
python3 - "$tmp/renamespaced.yaml" <<'PY'
import re, sys, yaml

docs = [d for d in yaml.safe_load_all(open(sys.argv[1])) if d]
crb = next(d for d in docs if d["kind"] == "ClusterRoleBinding" and d["metadata"]["name"].endswith("probe-from"))
vap = next(d for d in docs if d["kind"] == "ValidatingAdmissionPolicy")
cond = next(c["expression"] for c in vap["spec"]["matchConditions"] if c["name"] == "lookout-identity")

def matches(expr, user):
    # The two identity forms net probe-from's runtime guard recognizes.
    m = re.fullmatch(r"request\.userInfo\.username\.startsWith\('system:serviceaccount:'\) && request\.userInfo\.username\.endsWith\(':([^']+)'\)", expr)
    if m:
        return user.startswith("system:serviceaccount:") and user.endswith(":" + m.group(1))
    m = re.fullmatch(r"request\.userInfo\.username == '([^']+)'", expr)
    if m:
        return user == m.group(1)
    sys.exit("✗ deploy-probe/'s identity condition is in a form net probe-from cannot verify: " + expr)

for s in crb["subjects"]:
    if s["kind"] != "ServiceAccount":
        continue
    user = "system:serviceaccount:%s:%s" % (s["namespace"], s["name"])
    if s["namespace"] != "team-x-lookout":
        sys.exit("✗ re-namespacing did not rewrite the binding subject: " + user)
    if not matches(cond, user):
        sys.exit("✗ re-namespaced deploy-probe/ leaves %s UNGUARDED: the policy's identity condition (%s) no longer matches it" % (user, cond))
print("✓ re-namespaced deploy-probe/ keeps its admission policy on the granted ServiceAccount")
PY

# rbac.scope=namespace's strictly namespaced variant (#407): no ClusterRole at all.
helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" --set rbac.scope=namespace --set rbac.nodes=false >"$tmp/chart-strict.raw.yaml"
kustomize build deploy-namespaced-strict/ >"$tmp/kustomize-strict.raw.yaml"
normalize "$tmp/chart-strict.raw.yaml" "$tmp/chart-strict.yaml"
normalize "$tmp/kustomize-strict.raw.yaml" "$tmp/kustomize-strict.yaml"

if diff -u "$tmp/kustomize-strict.yaml" "$tmp/chart-strict.yaml" >"$tmp/diff-strict"; then
  echo "✓ chart with rbac.scope=namespace rbac.nodes=false matches deploy-namespaced-strict/"
else
  echo "✗ helm template --set rbac.scope=namespace --set rbac.nodes=false and deploy-namespaced-strict/ have diverged." >&2
  echo "  Left is kustomize build deploy-namespaced-strict/, right is helm template." >&2
  echo >&2
  cat "$tmp/diff-strict" >&2
  exit 1
fi

# ---- the chart must also be valid on its own --------------------------

helm lint "$CHART" --namespace "$NAMESPACE" --quiet

# Non-default paths the parity diff cannot reach, because the defaults
# reproduce the manifests and these deliberately do not. Rendering them
# is not a correctness proof; it catches the template that only fails
# when someone turns an option on, which is the worst time to find out.
render_ok() {
  local label="$1"; shift
  if ! helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" "$@" >/dev/null; then
    echo "✗ chart fails to render with $label" >&2
    exit 1
  fi
}

render_ok "serviceMonitor.enabled"  --set serviceMonitor.enabled=true
render_ok "persistence.enabled"     --set persistence.enabled=true
render_ok "persistence.existingClaim" --set persistence.enabled=true --set persistence.existingClaim=mine
render_ok "rbac disabled"           --set rbac.create=false --set rbac.capacity=false
render_ok "serviceAccount external" --set serviceAccount.create=false --set serviceAccount.name=other
render_ok "service disabled"        --set service.create=false --set networkPolicy.create=false
render_ok "gke flavor"              --set image.flavor=gke
render_ok "namespace scope, no secrets" --set rbac.scope=namespace --set rbac.secrets=false
# A namespace list renders one Role + RoleBinding per namespace and names
# every one of them in --namespace.
listed="$(helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" --set rbac.scope=namespace \
  --set-json 'rbac.namespaces=["team-a","team-b"]')"
if [[ "$(grep -c '^  namespace: team-' <<<"$listed")" != 4 ]] || ! grep -q -- '--namespace=team-a,team-b' <<<"$listed"; then
  echo "✗ rbac.namespaces=[team-a,team-b] did not render a Role per namespace and --namespace=team-a,team-b" >&2
  exit 1
fi
# A typo'd scope must fail the render, not fall back to either tier.
if helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" --set rbac.scope=namespaced >/dev/null 2>&1; then
  echo "✗ chart rendered with rbac.scope=namespaced — the guard in _helpers.tpl is not firing" >&2
  exit 1
fi
# A user who already chose an --enrich-lists keeps it; the chart must
# not append a second one.
if helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" --set rbac.secrets=false \
    --set-json 'args=["--enrich-lists=pods"]' | grep -q -- '--enrich-lists=all'; then
  echo "✗ rbac.secrets=false appended --enrich-lists over one already in args" >&2
  exit 1
fi
# Off by default, so it never appears in the diffed render above — this is the
# only check that the CRDs the chart serves from files/ are valid manifests.
render_ok "leewayPolicyCRD.install" --set leewayPolicyCRD.install=true

# serviceMonitor without a Service is a scrape target that silently
# selects nothing; the chart refuses it, and this asserts the refusal.
if helm template "$RELEASE_NAME" "$CHART" --namespace "$NAMESPACE" \
    --set serviceMonitor.enabled=true --set service.create=false >/dev/null 2>&1; then
  echo "✗ chart rendered a ServiceMonitor with service.create=false — the guard in templates/servicemonitor.yaml is not firing" >&2
  exit 1
fi

echo "✓ chart lints and renders on every non-default path"
