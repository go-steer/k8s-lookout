# Compile every package, once per provider build-tag variant. Catches
# packages that don't build but have no tests, and keeps every tag
# combination green from day one:
#   (none)       — vanilla Kubernetes, no cloud SDK linkage
#   gke          — + the GKE/GCP provider
#   allproviders — release umbrella: every provider implementation
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

for tags in "" "gke" "allproviders"; do
  if [[ -n "$tags" ]]; then
    echo "▸ go build -tags $tags ./..."
    go build -tags "$tags" ./...
  else
    echo "▸ go build ./..."
    go build ./...
  fi
done
