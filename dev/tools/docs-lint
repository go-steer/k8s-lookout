| `deploy-old/` | alias |
EOF
  if [[ -n "$(check_deploy_variants "$tmp/deploy-tree")" ]]; then
    echo "self-test: unexpected check_deploy_variants finding on clean tree"
    out=1
  fi

  if (( out == 0 )); then
    echo "docs-lint self-test: OK (all rules + deploy-variants + internal link self-test passed)"
  fi
  return $out
}

# ---- entry point ------------------------------------------------------

case "${1:-}" in
  --self-test) self_test ;;
  "")          run_all_checks ;;
  *)           echo "usage: $0 [--self-test]" >&2; exit 2 ;;
esac
