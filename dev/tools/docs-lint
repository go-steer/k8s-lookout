# Check 9: stale or unguarded signal/finding kind counts in hand-written prose
# (with fenced-code stripping and soft line-wrap support).
#
# Generated pages (docs/site reference/signal-kinds.md, detect/scan.md) are
# verified directly against checks.All() and schema.Kinds() by internal/sitedoc.
# In hand-written docs:
#   - `v1: <N> reserved names — <A> active + <R> retired` (signal-schema-v1.md),
#   - `<N>-kind inventory` (repo-map.md),
#   - `<A> active + <R> retired [= <N> reserved v1 names]` (repo-map.md, signal-schema-v1.md),
#   - `— <N> in the frozen schema —` (sentinel.md), and
#   - `<R> `leeway.*` wire kinds retired` (signal-schema-v1.md)
#   MUST match pkg/inject/schema/schema.go's live ledger
#   ($LIVE_TOTAL_KINDS = $LIVE_ACTIVE_KINDS active + $LIVE_RETIRED_KINDS retired).
#   - Any other numeric or spelled `<N> [signal|finding|...] kinds` or `<N>-kind`
#     (including across soft line wraps) is rejected.
check_kind_counts() {
  local path="$1"
  is_generated_site_doc "$path" && return 0

  python3 - "$path" "$LIVE_TOTAL_KINDS" "$LIVE_ACTIVE_KINDS" "$LIVE_RETIRED_KINDS" <<'PY'
import re
import sys

path = sys.argv[1]
want_total = int(sys.argv[2])
want_active = int(sys.argv[3])
want_retired = int(sys.argv[4])

WORDS = {
    "two": 2, "three": 3, "four": 4, "five": 5, "six": 6, "seven": 7,
    "eight": 8, "nine": 9, "ten": 10, "eleven": 11, "twelve": 12,
    "thirteen": 13, "fourteen": 14, "fifteen": 15, "sixteen": 16,
    "seventeen": 17, "eighteen": 18, "nineteen": 19, "twenty": 20,
    "thirty": 30, "forty": 40, "fifty": 50, "sixty": 60, "seventy": 70,
    "eighty": 80, "ninety": 90,
}

with open(path, encoding="utf-8") as fh:
    raw = fh.read()

# Blank out fenced code blocks while preserving line numbers.
lines = []
fence = None
for line in raw.splitlines():
    m = re.match(r"^\s*(`{3,}|~{3,})", line)
    if m:
        tok = m.group(1)
        if fence is None:
            fence = (tok[0], len(tok))
            lines.append("")
            continue
        if tok[0] == fence[0] and len(tok) >= fence[1] and re.match(r"^\s*" + re.escape(tok[0]) * len(tok) + r"\s*$", line):
            fence = None
            lines.append("")
            continue
    lines.append("" if fence is not None else line)
text = "\n".join(lines)

WS = r"(?:[ \t]|\n(?![ \t]*(?:$|[#|>*-]|\d+\.)))+"

V1_HEADER_RE = re.compile(
    rf"(?<![.\d])\bv1:{WS}(\d+){WS}reserved{WS}names{WS}—{WS}(\d+){WS}active{WS}\+{WS}(\d+){WS}retired\b",
    re.I,
)
INV_RE = re.compile(rf"(?<![.\d])\b(\d+)-kind{WS}inventory\b", re.I)
SPLIT_RE = re.compile(
    rf"(?<![.\d])\b(\d+){WS}active{WS}\+{WS}(\d+){WS}retired(?:{WS}={WS}(\d+){WS}reserved{WS}v1{WS}names)?\b",
    re.I,
)
FROZEN_SCHEMA_RE = re.compile(rf"—{WS}(\d+){WS}in{WS}the{WS}frozen{WS}schema{WS}—", re.I)
RETIRED_HEADER_RE = re.compile(
    rf"(?<![.\d])\b([a-z]+|\d+){WS}`leeway\.\*`{WS}wire{WS}kinds{WS}retired\b",
    re.I,
)
GENERIC_KIND_RE = re.compile(
    rf"(?<![.\d])\b(?:\d+|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|"
    rf"thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|"
    rf"twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:-[a-z]+)?"
    rf"(?:-kinds?\b|{WS}(?:(?:signal|finding|declared|shipped|frozen|v1|wire|audit|posture){WS})*kinds\b)",
    re.I,
)
ALLOW_PHRASES_RE = re.compile(
    rf"\bkinds{WS}of\b|\bfour{WS}RBAC{WS}kinds\b|\bthese{WS}eight{WS}kinds\b",
    re.I,
)


def blank_preserve_nl(s: str, rx: re.Pattern[str]) -> str:
    return rx.sub(lambda m: re.sub(r"[^\n]", " ", m.group(0)), s)


findings: list[tuple[int, str]] = []
rest = text

# 1. `v1: <N> reserved names — <A> active + <R> retired` (signal-schema-v1.md heading).
for m in V1_HEADER_RE.finditer(rest):
    got_t, got_a, got_r = int(m.group(1)), int(m.group(2)), int(m.group(3))
    if (got_t, got_a, got_r) != (want_total, want_active, want_retired):
        ln = rest.count("\n", 0, m.start()) + 1
        findings.append((
            ln,
            f"{path}:{ln}: stale v1 kind inventory header ({got_t} reserved = {got_a} active + {got_r} retired; "
            f"pkg/inject/schema/schema.go has {want_total} = {want_active} active + {want_retired} retired)",
        ))
rest = blank_preserve_nl(rest, V1_HEADER_RE)

# 2. `<N>-kind inventory` (repo-map.md).
for m in INV_RE.finditer(rest):
    got = int(m.group(1))
    if got != want_total:
        ln = rest.count("\n", 0, m.start()) + 1
        findings.append((
            ln,
            f"{path}:{ln}: stale schema kind count {got}-kind inventory "
            f"(pkg/inject/schema/schema.go has {want_total}: {want_active} active + {want_retired} retired)",
        ))
rest = blank_preserve_nl(rest, INV_RE)

# 3. `<A> active + <R> retired [= <N> reserved v1 names]`.
for m in SPLIT_RE.finditer(rest):
    got_a, got_r = int(m.group(1)), int(m.group(2))
    got_t = int(m.group(3)) if m.group(3) else got_a + got_r
    if (got_a, got_r, got_t) != (want_active, want_retired, want_total):
        ln = rest.count("\n", 0, m.start()) + 1
        findings.append((
            ln,
            f"{path}:{ln}: stale schema kind split {got_a} active + {got_r} retired = {got_t} "
            f"(pkg/inject/schema/schema.go has {want_active} active + {want_retired} retired = {want_total})",
        ))
rest = blank_preserve_nl(rest, SPLIT_RE)

# 4. `— <N> in the frozen schema —` (sentinel.md).
for m in FROZEN_SCHEMA_RE.finditer(rest):
    got = int(m.group(1))
    if got != want_total:
        ln = rest.count("\n", 0, m.start()) + 1
        findings.append((
            ln,
            f"{path}:{ln}: stale frozen-schema kind count {got} "
            f"(pkg/inject/schema/schema.go has {want_total})",
        ))
rest = blank_preserve_nl(rest, FROZEN_SCHEMA_RE)

# 5. `<R> `leeway.*` wire kinds retired` (signal-schema-v1.md).
for m in RETIRED_HEADER_RE.finditer(rest):
    tok = m.group(1).lower()
    got = int(tok) if tok.isdigit() else WORDS.get(tok, -1)
    if got != want_retired:
        ln = rest.count("\n", 0, m.start()) + 1
        findings.append((
            ln,
            f"{path}:{ln}: stale retired kind count {m.group(1)} "
            f"(pkg/inject/schema/schema.go has {want_retired} retired kinds)",
        ))
rest = blank_preserve_nl(rest, RETIRED_HEADER_RE)

# 6. Exclude allowed English phrases and reject all remaining unguarded kind counts.
rest = blank_preserve_nl(rest, ALLOW_PHRASES_RE)
for m in GENERIC_KIND_RE.finditer(rest):
    ln = rest.count("\n", 0, m.start()) + 1
    findings.append((
        ln,
        f"{path}:{ln}: hard-coded kind count — point to pkg/inject/schema "
        f"or /reference/finding-kinds/ instead of an unguarded count that drifts",
    ))

findings.sort(key=lambda item: item[0])
for _, msg in findings:
    print(msg)
PY
}

# Check 11: deployment variants README presence + docs/repo-map.md table sync (#852).
check_deploy_variants() {
  local root="${1:-.}"
  python3 - "$root" <<'PY'
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1]).resolve()
seen: set[str] = set()

deploy_dir = root / "deploy"
if deploy_dir.is_dir():
    for d in [deploy_dir, *deploy_dir.rglob("*")]:
        if not d.is_dir() or "templates" in d.relative_to(deploy_dir).parts:
            continue
        if (d / "kustomization.yaml").is_file() or (d / "Chart.yaml").is_file():
            seen.add(d.relative_to(root).as_posix() + "/")

for entry in root.iterdir():
    if entry.is_dir() and entry.name.startswith("deploy-"):
        seen.add(entry.name + "/")

live = sorted(seen)
for rel in live:
    readme = root / rel.rstrip("/") / "README.md"
    if not readme.is_file() or not readme.read_text(encoding="utf-8").strip():
        print(f"{rel}README.md:1: missing or empty README.md for deployment variant directory {rel}")

repo_map = root / "docs/repo-map.md"
if not repo_map.is_file():
    print("docs/repo-map.md:1: missing docs/repo-map.md")
    sys.exit(0)

row_re = re.compile(r"^\|\s*(?:\[`([^`]+)`\]\([^)]+\)|`([^`]+)`)")
in_sec = False
table: list[str] = []
for lineno, line in enumerate(repo_map.read_text(encoding="utf-8").splitlines(), 1):
    s = line.strip()
    if s.startswith("## "):
        if s == "## Deployment variants":
            in_sec = True
            continue
        if in_sec:
            break
    if not in_sec:
        continue
    m = row_re.match(s)
    if m:
        table.append(m.group(1) or m.group(2))

table_sorted = sorted(table)
if table_sorted != live:
    missing = sorted(set(live) - set(table_sorted))
    extra = sorted(set(table_sorted) - set(live))
    if missing:
        print(f"docs/repo-map.md:1: ## Deployment variants table missing live directories: {', '.join(missing)}")
    if extra:
        print(f"docs/repo-map.md:1: ## Deployment variants table lists non-existent directories: {', '.join(extra)}")
PY
}

# ---- driver -----------------------------------------------------------

run_all_checks() {
  local findings=0
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local out
    out=$(
      check_command_counts "$path"
      check_image_counts "$path"
      check_pinned_installs "$path"
      check_wrong_major_pins "$path"
      check_source_counts "$path"
      check_flag_counts "$path"
      check_scenario_counts "$path"
      check_kind_counts "$path"
    )
    if [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      findings=$((findings + $(printf '%s\n' "$out" | wc -l)))
    fi
  done < <(scoped_paths)

  # Wrong-domain check scans every Markdown file in the repo except CHANGELOG.md.
  while IFS= read -r md_path; do
    [[ -z "$md_path" ]] && continue
    local dom_out
    dom_out=$(check_wrong_domain "$md_path")
    if [[ -n "$dom_out" ]]; then
      printf '%s\n' "$dom_out"
      findings=$((findings + $(printf '%s\n' "$dom_out" | wc -l)))
    fi
  done < <(all_markdown_except_changelog)

  local link_out
  if ! link_out=$(python3 scripts/verify-internal-links.py --markdown-only 2>&1); then
    printf '%s\n' "$link_out"
    findings=$((findings + 1))
  fi

  local dep_out
  dep_out=$(check_deploy_variants ".")
  if [[ -n "$dep_out" ]]; then
    printf '%s\n' "$dep_out"
    findings=$((findings + $(printf '%s\n' "$dep_out" | wc -l)))
  fi

  if (( findings > 0 )); then
    echo ""
    echo "docs-lint: $findings finding(s). See remediation hints above."
    echo "Reference: dev/tools/docs-lint --self-test to see each rule in action."
    return 1
  fi
  return 0
}

