# Docs freshness linter — restored with the docs site (it was dropped
# at M0 when there was no prose surface to guard). Mirrored from
# core-agent's dev/tools/docs-lint, adapted to this tree: the
# "tool count" rule becomes a "command count" rule (our drift-prone
# invariant is the command surface, not a tool catalog) and the
# pinned-install rule matches this module's path.
#
# Fails on the small set of drift patterns that go stale the moment
# code lands. Not a spell-checker; not a style checker; not a
# link-checker (scripts/verify-internal-links.py covers built-site
# links in the Docs workflow). Just the four specific patterns.
#
# Checks:
#   1. Numeric command counts   — "19 commands", "Nineteen commands", "19-command"
#   2. Spelled image counts     — "three container variants", "four images", ...
#   3. Pinned @vX.Y.Z installs  — `go install github.com/go-steer/k8s-lookout/...@v0.6.0`
#   4. Wrong-major version pins — "as of v1.5", "Current release: v1.8.0"
#                                 (this repo is pre-v1; any v1.X.Y prose claim
#                                 is wrong today and rot-bait after v1)
#
# Scope:
#   README.md + docs/site/src/content/**/*.{md,mdx}. Nothing under
#   docs/*.md at the top level (DESIGN.md and the milestone records
#   are point-in-time documents), nothing under skills/ (generated
#   stubs + playbooks with their own drift gates), nothing under
#   CHANGELOG.md (version headers are the point).
#
# Usage:
#   dev/tools/docs-lint             — scan the tree, exit 1 on any finding
#   dev/tools/docs-lint --self-test — run against a synthetic fixture and
#                                     verify each rule fires (returns 0 if
#                                     every check catches its pattern)

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

# ---- paths in scope ---------------------------------------------------

scoped_paths() {
  find README.md docs/site/src/content -type f \( -name '*.md' -o -name '*.mdx' \) 2>/dev/null | sort
}

# ---- individual checks ------------------------------------------------
#
# Each check_* function takes a single markdown path and prints
# "path:line: <message>" lines. No output = clean.

# Check 1: numeric command counts.
#
# Fires on the drift shape "N commands" / "N-command surface" /
# "Nineteen commands" — every new read-path command would rot the
# number. Does NOT fire on path-like lines (tree-drawing chars,
# embedded filenames) or on "command" used adjectivally after a
# hyphenated word ("multi-command").
check_command_counts() {
  local path="$1"
  awk -v p="$path" '
    # Skip lines that look like directory-tree entries or contain a
    # markdown/go filename — these are code-shaped, not prose.
    /^[ \t│├└─┌┐┘┴┬┼]+/ && /\.(md|go|yaml|yml|json|sh|ts|tsx|py)/ { next }

    # Digit form, hyphenated: "19-command" only when the char after
    # command[s] is a sentence delimiter.
    match($0, /(^|[^A-Za-z0-9])[0-9]+-commands?([ .,;:)]|$)/) {
      printf "%s:%d: numeric command count — list commands by group (triage / state / stab / …) instead of a count that drifts on every new command\n", p, NR
      next
    }
    # Digit form, space-separated. Require PLURAL "commands".
    match($0, /(^|[^A-Za-z0-9])[0-9]+ commands\b/) {
      printf "%s:%d: numeric command count — list commands by group (triage / state / stab / …) instead of a count that drifts on every new command\n", p, NR
      next
    }
    # Spelled form: Ten..Twenty [space or hyphen] command[s].
    match($0, /(^|[^A-Za-z])(Ten|Eleven|Twelve|Thirteen|Fourteen|Fifteen|Sixteen|Seventeen|Eighteen|Nineteen|Twenty)[- ]?commands?/) {
      printf "%s:%d: spelled command count — list commands by group (triage / state / stab / …) instead of a count that drifts on every new command\n", p, NR
    }
  ' "$path"
}

# Check 2: spelled or numeric image-variant counts.
#
# Matches: three images / four container variants / 4-image ...
# The release-images matrix is the ground truth; describing variants
# by name is drift-safe.
check_image_counts() {
  local path="$1"
  grep -n -E '\b(two|three|four|five|six|seven|[2-9]|1[0-9])[- ]?(container|image|variant)s?\b' "$path" 2>/dev/null | \
    awk -F: -v p="$path" '{
      msg = "hard-coded container/image count — describe variants by name (lookout / -gke) or use a table";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 3: pinned @vX.Y.Z in a go get / go install snippet referencing
# our own module. Use @latest (or a shell variable) instead.
#
# `go install github.com/go-steer/k8s-lookout/cmd/lookout@v0.6.0`  ← bad
# `go install github.com/go-steer/k8s-lookout/cmd/lookout@latest`  ← good
check_pinned_installs() {
  local path="$1"
  grep -n -E 'go (get|install)\s+github\.com/go-steer/k8s-lookout[^ ]*@v[0-9]+\.[0-9]+\.[0-9]+' "$path" 2>/dev/null | \
    awk -F: -v p="$path" '{
      msg = "pinned @vX.Y.Z in install snippet — use @latest so the doc doesn'\''t rot after the next release";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 4: wrong-major (v1.X.Y) prose version claims.
#
# This repo is pre-v1: any prose claim of a v1.X.Y release is wrong
# today, and once v1 lands the same patterns become the rot-bait
# core-agent's rule exists for. v0.X.Y appears only in CHANGELOG
# (out of scope) and the milestone records (out of scope), never in
# the scanned prose — keep it that way by describing releases as
# "the current release" and linking the tag list.
#
# Accepted forms (allow-listed):
#   `## [1.X.Y]` in CHANGELOG-shape section headers
#   `(since v1.X.Y)` — intentional "this feature landed in" annotation
#   `pre-v1.X.Y`    — intentional "before this version" annotation
#   `post-v1.X.Y`   — intentional "after this version" annotation
#   `v1.X.Y+`       — "since vX or later"
check_wrong_major_pins() {
  local path="$1"
  grep -n -E '\bv1\.[0-9]+\.[0-9]+\b' "$path" 2>/dev/null | \
    grep -v -E '^\s*[0-9]+:## \[1\.' | \
    grep -v -E '\(since v1\.' | \
    grep -v -E '\bpre-v1\.[0-9]' | \
    grep -v -E '\bpost-v1\.[0-9]' | \
    grep -v -E 'v1\.[0-9]+(\.[0-9]+)?\+' | \
    awk -F: -v p="$path" '{
      msg = "v1.X.Y in prose — drop the version or convert to a `(since vX.Y.Z)` historical marker";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# ---- driver -----------------------------------------------------------

run_all_checks() {
  local findings=0
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    local out
    out=$(
      check_command_counts "$path"
      check_image_counts "$path"
      check_pinned_installs "$path"
      check_wrong_major_pins "$path"
    )
    if [[ -n "$out" ]]; then
      printf '%s\n' "$out"
      findings=$((findings + $(printf '%s\n' "$out" | wc -l)))
    fi
  done < <(scoped_paths)

  if (( findings > 0 )); then
    echo ""
    echo "docs-lint: $findings finding(s). See remediation hints above."
    echo "Reference: dev/tools/docs-lint --self-test to see each rule in action."
    return 1
  fi
  return 0
}

# ---- self-test --------------------------------------------------------
#
# Writes a fixture into a temp dir, points the scan at it, and verifies
# every rule fires at least once. Used by anyone editing this script to
# confirm the rules still catch what they should.

self_test() {
  local tmp
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064
  trap "rm -rf '$tmp'" EXIT

  cat > "$tmp/fixture.md" <<'EOF'
# Fixture

The 19-command read path is stale phrasing.
Nineteen commands are registered by default.

We ship two container images: `lookout` and `lookout-gke`.

Install with:

```
go install github.com/go-steer/k8s-lookout/cmd/lookout@v0.6.0
```

Current release: v1.8.0.
EOF

  local out=0
  # Run each check directly against the fixture and confirm it produces
  # at least one finding line. Failure of any check → self-test failure.
  local n
  n=$(check_command_counts "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_command_counts fired 0 times, expected ≥1"; out=1; }

  n=$(check_image_counts "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_image_counts fired 0 times, expected ≥1"; out=1; }

  n=$(check_pinned_installs "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_pinned_installs fired 0 times, expected ≥1"; out=1; }

  n=$(check_wrong_major_pins "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_wrong_major_pins fired 0 times, expected ≥1"; out=1; }

  if (( out == 0 )); then
    echo "docs-lint self-test: OK (all 4 rules fired on the fixture)"
  fi
  return $out
}

# ---- entry point ------------------------------------------------------

case "${1:-}" in
  --self-test) self_test ;;
  "")          run_all_checks ;;
  *)           echo "usage: $0 [--self-test]" >&2; exit 2 ;;
esac
