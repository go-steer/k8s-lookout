  local out=0
  local n
  n=$(check_command_counts "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_command_counts fired 0 times, expected ≥1"; out=1; }

  n=$(check_image_counts "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_image_counts fired 0 times, expected ≥1"; out=1; }

  n=$(check_pinned_installs "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_pinned_installs fired 0 times, expected ≥1"; out=1; }

  n=$(check_wrong_major_pins "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_wrong_major_pins fired 0 times, expected ≥1"; out=1; }

  n=$(check_source_counts "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_source_counts fired 0 times, expected ≥1"; out=1; }

  n=$(check_wrong_domain "$tmp/fixture.md" | wc -l)
  (( n >= 1 )) || { echo "self-test: check_wrong_domain fired 0 times, expected ≥1"; out=1; }

  n=$(check_flag_counts "$tmp/fixture.md" | wc -l)
  (( n >= 3 )) || { echo "self-test: check_flag_counts fired $n times, expected ≥3"; out=1; }

  n=$(check_scenario_counts "$tmp/fixture.md" | wc -l)
  (( n >= 2 )) || { echo "self-test: check_scenario_counts fired $n times, expected ≥2"; out=1; }

  n=$(check_kind_counts "$tmp/fixture.md" | wc -l)
  (( n >= 4 )) || { echo "self-test: check_kind_counts fired $n times, expected ≥4"; out=1; }

  local clean_out
  clean_out=$(
    check_wrong_domain "$tmp/clean.md"
    check_flag_counts "$tmp/clean.md"
    check_scenario_counts "$tmp/clean.md"
    check_kind_counts "$tmp/clean.md"
  )
  if [[ -n "$clean_out" ]]; then
    echo "self-test: unexpected false positive on clean fixture:"
    printf '%s\n' "$clean_out"
    out=1
  fi

  if ! python3 scripts/verify-internal-links.py --self-test >/dev/null; then
    echo "self-test: verify-internal-links.py --self-test failed"
    out=1
  fi

  mkdir -p "$tmp/deploy-tree/deploy/base" "$tmp/deploy-tree/deploy-old" "$tmp/deploy-tree/docs"
  touch "$tmp/deploy-tree/deploy/base/kustomization.yaml" "$tmp/deploy-tree/deploy-old/kustomization.yaml"
  echo "# base" > "$tmp/deploy-tree/deploy/base/README.md"
  cat > "$tmp/deploy-tree/docs/repo-map.md" <<'EOF'
