# Docs freshness linter — restored with the docs site (it was dropped
# at M0 when there was no prose surface to guard). Mirrored from
# core-agent's dev/tools/docs-lint, adapted to this tree.
#
# Fails on drift patterns that go stale the moment code lands, plus
# broken relative/internal Markdown links across README.md and docs/**.
#
# Checks:
#   1. Numeric command counts      — "19 commands", "Nineteen commands", "19-command"
#   2. Spelled image counts        — "three container variants", "four images", ...
#   3. Pinned @vX.Y.Z installs     — `go install github.com/go-steer/k8s-lookout/...@v0.6.0`
#   4. Wrong-major version pins    — "as of v1.5", "Current release: v1.8.0"
#                                    (this repo is pre-v1; any v1.X.Y prose claim
#                                    is wrong today and rot-bait after v1)
#   5. Signal-source counts        — "nine signal sources", "11 sources", ...
#   6. Wrong published domain      — `k8s-lookout.dev` across all repo Markdown
#                                    (except CHANGELOG.md; site is published at
#                                    https://go-steer.github.io/k8s-lookout/)
#   7. Hardcoded flag counts       — "table of all 57 flags", "97 flags", ...
#   8. Hardcoded scenario counts   — "ten inject/verify/revert failure scenarios", ...
#   9. Stale/unguarded kind counts — "32-kind inventory", "48 signal kinds", ...
#  10. Internal Markdown links     — scripts/verify-internal-links.py --markdown-only
#                                    over README.md, docs/**, and deploy*/**/*.md
#  11. Deployment variants ledger  — every deploy* directory has a README.md and
#                                    appears in docs/repo-map.md ## Deployment variants
#
# Scope:
#   Prose-count rules (1–5, 7–9) scan root contributor/user docs (README.md,
#   AGENTS.md, CONTRIBUTING.md, ROADMAP.md, SECURITY.md), living reference
#   docs (docs/repo-map.md, docs/adding-a-check.md, docs/cli-stability-policy.md,
#   docs/release-process.md, docs/signal-schema-v1.md,
#   docs/audit-ingestion-contract.md, examples/README.md,
#   deploy-namespaced/README.md, deploy/chart/README.md), and
#   docs/site/src/content/**/*.{md,mdx}. Check 6 (wrong domain) scans every
#   Markdown file in the repository except CHANGELOG.md, and Check 10 verifies
#   internal Markdown links across README.md and docs/**.
#
# Usage:
#   dev/tools/docs-lint             — scan the tree, exit 1 on any finding
#   dev/tools/docs-lint --self-test — run against synthetic fixtures and
#                                     verify each rule fires (returns 0 if
#                                     every check catches its pattern)

set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

# ---- live tree counts (computed once from authoritative ledgers) ------

LIVE_WATCH_FLAGS=$(grep -cvE '^(#|$)' internal/watch/testdata/watch_flags.golden || true)
LIVE_SCENARIOS=$(find examples/scenarios -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')

read -r LIVE_TOTAL_KINDS LIVE_ACTIVE_KINDS LIVE_RETIRED_KINDS < <(
  python3 - pkg/inject/schema/schema.go <<'PY'
import re
import sys

with open(sys.argv[1], encoding="utf-8") as fh:
    src = fh.read()

# Strip line comments while preserving structure inside `var kinds = []KindSpec{ ... }`.
clean_lines = []
for line in src.splitlines():
    in_str = False
    esc = False
    out = []
    i = 0
    while i < len(line):
        ch = line[i]
        if in_str:
            out.append(ch)
            if esc:
                esc = False
            elif ch == "\\":
                esc = True
            elif ch == '"':
                in_str = False
            i += 1
            continue
        if ch == '"':
            in_str = True
            out.append(ch)
            i += 1
            continue
        if line[i:i+2] == "//":
            break
        out.append(ch)
        i += 1
    clean_lines.append("".join(out))

body_src = "\n".join(clean_lines)
m = re.search(r"\bvar\s+kinds\s*=\s*\[\]KindSpec\s*\{([\s\S]*?)\n\}", body_src)
if not m:
    raise SystemExit("failed to locate `var kinds = []KindSpec{...}` in pkg/inject/schema/schema.go")

block = m.group(1)
# Extract each top-level `{ ... }` KindSpec literal inside the slice.
entries = []
depth = 0
start = None
in_str = False
esc = False
for idx, ch in enumerate(block):
    if in_str:
        if esc:
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == '"':
            in_str = False
        continue
    if ch == '"':
        in_str = True
        continue
    if ch == "{":
        if depth == 0:
            start = idx
        depth += 1
    elif ch == "}":
        depth -= 1
        if depth == 0 and start is not None:
            entries.append(block[start + 1:idx])
            start = None

active = 0
retired = 0
for entry in entries:
    m_named = re.search(r"\bRetired\s*:\s*(true|false)\b", entry)
    if m_named:
        is_ret = m_named.group(1) == "true"
    else:
        m_pos = re.search(r",\s*(true|false)\s*,?\s*$", entry.strip())
        if not m_pos:
            raise SystemExit(f"cannot determine Retired bool for KindSpec entry: {entry!r}")
        is_ret = m_pos.group(1) == "true"
    if is_ret:
        retired += 1
    else:
        active += 1

print(f"{active + retired} {active} {retired}")
PY
)

is_generated_site_doc() {
  head -n 10 "$1" | grep -q 'Generated by dev/tools/gen-site-docs'
}

# ---- paths in scope ---------------------------------------------------

scoped_paths() {
  find \
    README.md AGENTS.md CONTRIBUTING.md ROADMAP.md SECURITY.md \
    docs/repo-map.md docs/adding-a-check.md docs/cli-stability-policy.md \
    docs/release-process.md docs/signal-schema-v1.md docs/audit-ingestion-contract.md \
    examples/README.md deploy deploy-* \
    docs/site/src/content \
    -type f \( -name '*.md' -o -name '*.mdx' \) 2>/dev/null | sort -u
}

all_markdown_except_changelog() {
  find . \
    \( -name .git -o -name .worktrees -o -name node_modules -o -name dist \) -prune -o \
    -type f \( -name '*.md' -o -name '*.mdx' \) ! -path './CHANGELOG.md' -print | \
    sed 's|^\./||' | sort
}

# ---- individual checks ------------------------------------------------
#
# Each check_* function takes a single markdown path and prints
# "path:line: <message>" lines. No output = clean.

# Check 1: numeric command counts.
check_command_counts() {
  local path="$1"
  awk -v p="$path" '
    /^[ \t│├└─┌┐┘┴┬┼]+/ && /\.(md|go|yaml|yml|json|sh|ts|tsx|py)/ { next }

    match($0, /(^|[^A-Za-z0-9])[0-9]+-commands?([ .,;:)]|$)/) {
      printf "%s:%d: numeric command count — list commands by group (triage / state / stab / …) instead of a count that drifts on every new command\n", p, NR
      next
    }
    match($0, /(^|[^A-Za-z0-9])[0-9]+ commands\b/) {
      printf "%s:%d: numeric command count — list commands by group (triage / state / stab / …) instead of a count that drifts on every new command\n", p, NR
      next
    }
    match($0, /(^|[^A-Za-z])(Ten|Eleven|Twelve|Thirteen|Fourteen|Fifteen|Sixteen|Seventeen|Eighteen|Nineteen|Twenty)[- ]?commands?/) {
      printf "%s:%d: spelled command count — list commands by group (triage / state / stab / …) instead of a count that drifts on every new command\n", p, NR
    }
  ' "$path"
}

# Check 2: spelled or numeric image-variant counts.
check_image_counts() {
  local path="$1"
  grep -n -E '\b(two|three|four|five|six|seven|[2-9]|1[0-9])[- ]?(container|image|variant)s?\b' "$path" 2>/dev/null | \
    grep -v -E '(^| )(container|image|variant)s?=' | \
    awk -F: -v p="$path" '{
      msg = "hard-coded container/image count — describe variants by name (lookout / -gke) or use a table";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 3: pinned @vX.Y.Z in a go get / go install snippet referencing our module.
check_pinned_installs() {
  local path="$1"
  grep -n -E 'go (get|install)\s+github\.com/go-steer/k8s-lookout[^ ]*@v[0-9]+\.[0-9]+\.[0-9]+' "$path" 2>/dev/null | \
    awk -F: -v p="$path" '{
      msg = "pinned @vX.Y.Z in install snippet — use @latest so the doc doesn'\''t rot after the next release";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 4: wrong-major (v1.X.Y) prose version claims.
check_wrong_major_pins() {
  local path="$1"
  grep -n -E '\bv1\.[0-9]+\.[0-9]+\b' "$path" 2>/dev/null | \
    grep -v -E '^\s*[0-9]+:## \[1\.' | \
    grep -v -E '\(since v1\.' | \
    grep -v -E '\bpre-v1\.[0-9]' | \
    grep -v -E '\bpost-v1\.[0-9]' | \
    grep -v -E 'v1\.[0-9]+(\.[0-9]+)?\+' | \
    awk -F: -v p="$path" '{
      msg = "v1.X.Y in prose — drop the version or convert to a `(since vX.Y.Z)` historical marker";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 5: numeric or spelled signal-source counts in prose.
check_source_counts() {
  local path="$1"
  grep -n -E '\b(seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|[7-9]|1[0-9])[- ]+(§7\.2 )?(signal )?sources\b' "$path" 2>/dev/null | \
    grep -v -E 'of the [a-z]+ sources are never auto-enabled' | \
    awk -F: -v p="$path" '{
      msg = "hard-coded source count — describe sources by role or link §7.2 instead of a count that drifts";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 6: wrong site domain (`k8s-lookout.dev`).
check_wrong_domain() {
  local path="$1"
  grep -n -E 'k8s-lookout\.dev' "$path" 2>/dev/null | \
    awk -F: -v p="$path" '{
      msg = "wrong docs domain k8s-lookout.dev — use https://go-steer.github.io/k8s-lookout/ (docs/site/astro.config.mjs)";
      printf "%s:%s: %s\n", p, $1, msg
    }' || true
}

# Check 7: hardcoded CLI / watch flag counts in prose (including soft line wraps).
#
# Catches drift-prone totals ("table of all 57 flags", "97 flags",
# "97 configuration flags", "97 `lookout watch` flags", "57-flag").
# Allow-lists the permanently frozen M0 predecessor count ("the 19
# predecessor flags" in docs/cli-stability-policy.md, pinned by
# TestFlagSurfaceFrozen) and local 2–4 flag tuples ("Two flags select",
# "behind three flags").
check_flag_counts() {
  local path="$1"
  is_generated_site_doc "$path" && return 0

  python3 - "$path" "$LIVE_WATCH_FLAGS" <<'PY'
import re
import sys

path, live = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    raw = fh.read()

lines = []
fence = None
for line in raw.splitlines():
    m = re.match(r"^\s*(`{3,}|~{3,})", line)
    if m:
        tok = m.group(1)
        if fence is None:
            fence = (tok[0], len(tok))
            lines.append("")
            continue
        if tok[0] == fence[0] and len(tok) >= fence[1] and re.match(r"^\s*" + re.escape(tok[0]) * len(tok) + r"\s*$", line):
            fence = None
            lines.append("")
            continue
    lines.append("" if fence is not None else line)
text = "\n".join(lines)

WS = r"(?:[ \t]|\n(?![ \t]*(?:$|[#|>*-]|\d+\.)))+"
MOD = r"(?:`[^`\n]+`|[A-Za-z][A-Za-z0-9_/-]*)"
NUM_ALL = r"(?:\d+|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:-[a-z]+)?"
NUM_5PLUS = r"(?:[5-9]|[1-9]\d+|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen|twenty|thirty|forty|fifty|sixty|seventy|eighty|ninety)(?:-[a-z]+)?"

FLAG_RE = re.compile(
    rf"(?<![.\d])(?:"
    rf"\b(?:all|every){WS}{NUM_ALL}(?:{WS}{MOD}){{0,2}}{WS}flags\b"
    rf"|\b{NUM_5PLUS}(?:-|{WS})(?:{MOD}{WS}){{0,2}}flags\b"
    rf"|\b(?:[5-9]|[1-9]\d+)-flag\b"
    rf")",
    re.I | re.M,
)

for m in FLAG_RE.finditer(text):
    ctx_slice = re.sub(r"\s+", " ", text[max(0, m.start() - 10):min(len(text), m.end() + 25)]).lower()
    if "19 predecessor flags" in ctx_slice:
        continue
    lineno = text.count("\n", 0, m.start()) + 1
    print(
        f"{path}:{lineno}: hard-coded flag count (watch_flags.golden currently has {live}) "
        f"— link /reference/watch/ without a count that drifts"
    )
PY
}

