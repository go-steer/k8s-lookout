# Scaffold a new read-path check: the command file, its test suite, and
# a first golden.
#
#   dev/tools/new-check --group=state --check=quotas \
#     --summary="When creates are rejected with 'exceeded quota': ..."
#
# What comes out compiles and its tests pass, emitting nothing — a
# working command from the first commit. The tool then prints the
# touchpoints only a human can decide (scan membership, RBAC, skills).
# docs/adding-a-check.md walks a real check end to end.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

go run ./internal/newcheck -root . "$@"
