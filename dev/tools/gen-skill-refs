# Regenerate skills/*/references/*.md from the pkg/checks command
# metadata (DESIGN.md §4.4.3: one source of truth, generated
# outward). Re-runnable; output is deterministic. CI enforces
# freshness via internal/skilldoc's drift test — if you changed a
# command's metadata, run this and commit the diff.
set -euo pipefail
. "$(dirname "$0")/common.sh"
cd "$(repo_root)"

go run ./internal/skilldoc/gen -root .
