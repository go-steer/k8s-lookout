# Prepare a fresh Debian 12 VM to host the soak: docker, kind, kubectl,
# and the inotify limits seven kind nodes need. Run as root. Idempotent.

set -euo pipefail

KIND_VERSION="${KIND_VERSION:-v0.32.0}"
KUBECTL_VERSION="${KUBECTL_VERSION:-v1.36.4}"

if ! command -v docker >/dev/null; then
  apt-get update -q
  apt-get install -y -q docker.io python3 curl
fi
systemctl enable --now docker

if ! command -v kind >/dev/null || ! kind version | grep -q "$KIND_VERSION"; then
  curl -fsSLo /usr/local/bin/kind "https://kind.sigs.k8s.io/dl/$KIND_VERSION/kind-linux-amd64"
  chmod +x /usr/local/bin/kind
fi
if ! command -v kubectl >/dev/null; then
  curl -fsSLo /usr/local/bin/kubectl "https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl"
  chmod +x /usr/local/bin/kubectl
fi

# kind's known-issues values; the defaults run out at around three nodes.
cat >/etc/sysctl.d/90-kind.conf <<'EOF'
fs.inotify.max_user_watches = 524288
fs.inotify.max_user_instances = 512
EOF
sysctl -q --system

docker version --format 'docker {{.Server.Version}}'
kind version
kubectl version --client | head -1
