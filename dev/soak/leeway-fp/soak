# The leeway false-positive soak: run the sentinel at production leeway
# settings against a kind cluster shaped like a three-zone regional
# cluster, churn it the way a healthy cluster churns, and count every
# leeway finding that reaches the wire or the store. Under benign churn
# the right number is zero, so every finding is either a false positive
# or real drift the churn produced; summarize.py lays out the evidence
# needed to tell which. See README.md.
#
# Usage:
#   soak up                 kind cluster (7 nodes, 3 zones) + sentinel + workloads
#   soak run <duration>     collectors + churn for <duration> (e.g. 45m, 72h), then summary
#   soak summary            re-run the summary over what has been collected
#   soak down               delete the kind cluster (keeps $SOAK_DIR)
#
# Env:
#   SOAK_DIR        where everything is written (default ./out); must be absolute
#                   or relative to the current directory
#   SOAK_CLUSTER    kind cluster name (default leeway-fp)
#   LOOKOUT_IMAGE   sentinel image (default lookout:fp-soak; must already be
#                   in the local docker image store, or set LOOKOUT_IMAGE_TAR)
#   LOOKOUT_IMAGE_TAR  docker-save tarball to load first (optional)
#   SOAK_SEED       churn RNG seed (default 416)
#   SOAK_CHURN_SCALE  multiplies every churn interval (default 1; 0.25 for a
#                   fast smoke run)
#   SOAK_NODE_CPUS / SOAK_NODE_MEMORY  per-worker docker caps (default 1 / 3g);
#                   the control plane gets three times both
#   SOAK_ZONE_AFFINITY  1 (default) gives every soak pod a required node
#                   affinity on the zone label; 0 drops it, which reproduces
#                   the unlabelled-node false positive (see kind_config)

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(cd "$here/../../.." && pwd)"

CLUSTER="${SOAK_CLUSTER:-leeway-fp}"
SOAK_DIR="$(mkdir -p "${SOAK_DIR:-out}" && cd "${SOAK_DIR:-out}" && pwd)"
IMAGE="${LOOKOUT_IMAGE:-lookout:fp-soak}"
NODE_CPUS="${SOAK_NODE_CPUS:-1}"
NODE_MEMORY="${SOAK_NODE_MEMORY:-3g}"
# Never the caller's kubeconfig: this script cordons, drains and pauses
# nodes, and must not be able to reach any cluster but its own.
export KUBECONFIG="$SOAK_DIR/kubeconfig"
NS=agent-triage
METRICS_SERVER=v0.9.0
WORKLOAD_IMAGES=(registry.k8s.io/pause:3.9 registry.k8s.io/pause:3.10 python:3.12-alpine)

log() { echo "▸ $(date -u +%FT%TZ) $*"; }

kind_config() {
  # Three zones of two workers each, and two node pools that each span
  # all three zones — the shape of a regional GKE cluster, so node-group
  # subjects are exercised too. The control plane carries no zone label
  # and keeps its NoSchedule taint: it hosts only the sentinel and the
  # capture stub, which churn never touches.
  #
  # Leeway (v0.29) counts a node that lacks a spread key's label as an
  # eligible domain, "__unknown__", and with nodeTaintsPolicy at its
  # default (Ignore) a tainted node is eligible too. So the control plane
  # becomes a fourth zone holding no pods, every evenly spread workload
  # reads skew = its largest zone, and leeway fires rollout_bias at Tier A
  # within one dwell. kube-scheduler instead skips nodes without the key.
  # GKE never shows leeway its control plane, and every node a workload
  # can land on there carries the zone label. workloads.py gets the same
  # effect by giving each pod a required affinity on the zone label existing,
  # which takes the control plane out of every workload's eligible set.
  # Cordoning it instead does not work: an unlabelled, cordoned node is an
  # __unknown__ domain with no schedulable nodes, which leeway raises as
  # domain_unavailable.
  #
  # The real topology.kubernetes.io/zone label, unlike examples/: this
  # soak is about production behaviour, including the assumed cluster
  # default spread that applies on that key.
  local zones=(zone-a zone-a zone-b zone-b zone-c zone-c)
  local pools=(pool-1 pool-2 pool-1 pool-2 pool-1 pool-2)
  cat <<EOF
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
  - role: control-plane
    extraMounts:
      - hostPath: $SOAK_DIR/wire
        containerPath: /fp-wire
      - hostPath: $SOAK_DIR/store
        containerPath: /fp-store
    kubeadmConfigPatches:
      - |
        kind: KubeletConfiguration
        containerLogMaxSize: 500Mi
        containerLogMaxFiles: 3
EOF
  local i
  for i in "${!zones[@]}"; do
    cat <<EOF
  - role: worker
    labels:
      topology.kubernetes.io/zone: ${zones[$i]}
      topology.kubernetes.io/region: soak-region
      cloud.google.com/gke-nodepool: ${pools[$i]}
EOF
  done
}

cmd_up() {
  for tool in kind kubectl docker python3; do
    command -v "$tool" >/dev/null || {
      echo "ERROR: $tool not on PATH" >&2
      exit 1
    }
  done
  mkdir -p "$SOAK_DIR/wire" "$SOAK_DIR/store"
  # The stub (uid 65534) and the sentinel (uid 65532) write here
  # through hostPath mounts.
  chmod 0777 "$SOAK_DIR/wire" "$SOAK_DIR/store"

  if kind get clusters 2>/dev/null | grep -qx "$CLUSTER"; then
    log "kind cluster $CLUSTER exists — reusing"
  else
    kind_config >"$SOAK_DIR/kind.yaml"
    log "creating kind cluster $CLUSTER"
    kind create cluster --name "$CLUSTER" --config "$SOAK_DIR/kind.yaml" --wait 5m
  fi
  # Capped so a churn burst cannot starve the whole VM, with the
  # control plane given room: an apiserver starved of CPU misses node
  # heartbeats, and spurious NotReady nodes would be a confound the soak
  # created rather than one it found.
  local n cpus mem
  for n in $(kind get nodes --name "$CLUSTER"); do
    cpus="$NODE_CPUS" mem="$NODE_MEMORY"
    if [[ "$n" == *-control-plane ]]; then
      cpus="$(python3 -c "print($NODE_CPUS*3)")"
      mem="$((${NODE_MEMORY%g} * 3))g"
    fi
    docker update --cpus "$cpus" --memory "$mem" --memory-swap "$mem" "$n" >/dev/null
  done
  kubectl wait --for=condition=Ready nodes --all --timeout=300s

  log "metrics-server (so --sources=auto enables saturation, as on GKE)"
  # Every image is side-loaded, metrics-server's included: the nodes
  # never pull, so a VM whose kind network has no working upstream DNS
  # (Debian 12's docker.io is one) runs the soak the same.
  curl -fsSLo "$SOAK_DIR/metrics-server.yaml" \
    "https://github.com/kubernetes-sigs/metrics-server/releases/download/$METRICS_SERVER/components.yaml"
  local ms_image
  ms_image="$(grep -m1 -o 'image: .*' "$SOAK_DIR/metrics-server.yaml" | cut -d' ' -f2)"
  docker image inspect "$ms_image" >/dev/null 2>&1 || docker pull -q "$ms_image"
  kind load docker-image --name "$CLUSTER" "$ms_image"
  kubectl apply -f "$SOAK_DIR/metrics-server.yaml"
  kubectl -n kube-system patch deployment metrics-server --type=json -p '[
    {"op":"add","path":"/spec/template/spec/containers/0/args/-","value":"--kubelet-insecure-tls"}]'
  kubectl -n kube-system rollout status deploy/metrics-server --timeout=300s

  log "side-loading images"
  [[ -n "${LOOKOUT_IMAGE_TAR:-}" ]] && docker load -i "$LOOKOUT_IMAGE_TAR"
  local img
  for img in "${WORKLOAD_IMAGES[@]}"; do
    docker image inspect "$img" >/dev/null 2>&1 || docker pull -q "$img"
  done
  kind load docker-image --name "$CLUSTER" "$IMAGE" "${WORKLOAD_IMAGES[@]}"

  deploy_sentinel
  log "workloads"
  python3 "$here/workloads.py" | kubectl apply -f -
  kubectl get deploy,statefulset -n fp-soak --no-headers | wc -l | xargs echo "  workloads:"
}

deploy_sentinel() {
  log "sentinel + capture stub"
  kubectl create namespace "$NS" --dry-run=client -o yaml | kubectl apply -f -
  kubectl -n "$NS" create secret generic lookout-watch-token \
    --from-literal=token=fp-soak-stub-token --dry-run=client -o yaml | kubectl apply -f -
  kubectl -n "$NS" create configmap stub-daemon \
    --from-file=stub-daemon.py="$root/dev/drills/stub-daemon.py" \
    --from-file=stamp.py="$here/stamp.py" \
    --from-file=serve.py="$here/serve.py" \
    --dry-run=client -o yaml | kubectl apply -f -
  kubectl apply -f "$here/stub.yaml"
  # The shipped manifests, unmodified, then the soak's patches.
  kubectl apply -k "$root/deploy/"

  # Production leeway settings: every --topology-* and --compute-class-*
  # flag at its default, except the two that put Tier C on the wire so
  # its findings are counted too. --sources rides the binary's auto
  # default, as the shipped manifest does. The store is a hostPath so
  # info-routed findings (Tier C lands there) can be read off the VM.
  #
  # The daemon URL's host is fully qualified (trailing dot). Without the
  # dot it has fewer than ndots:5 dots, so each lookup tries the host's
  # search domains first. CoreDNS forwards those upstream, and on a VM
  # whose kind network has no working upstream DNS each one times out.
  # Every POST then overran its client timeout, and injects were lost.
  local args=(
    "--daemon-url=http://core-agent.agent-triage.svc.cluster.local.:7777"
    "--token-env=WATCHER_TOKEN"
    "--mode=per-incident"
    "--owner=fp-soak@local"
    "--cluster-name=$CLUSTER"
    "--dedup-window=5m"
    "--in-cluster"
    "--metrics-addr=:9090"
    "--log-level=info"
    "--storm=on"
    "--store=/var/lib/lookout/lookout.db"
    "--topology-tier-c-signals"
    "--compute-class-tier-c-signals"
  )
  local args_json
  args_json="$(printf '"%s",' "${args[@]}")"
  args_json="[${args_json%,}]"
  kubectl -n "$NS" patch deployment lookout-watch --type=json -p "[
    {\"op\":\"replace\",\"path\":\"/spec/template/spec/containers/0/image\",\"value\":\"$IMAGE\"},
    {\"op\":\"replace\",\"path\":\"/spec/template/spec/containers/0/args\",\"value\":$args_json}]"
  kubectl -n "$NS" patch deployment lookout-watch --type=strategic -p '{"spec":{"template":{"spec":{
    "nodeSelector":{"node-role.kubernetes.io/control-plane":""},
    "tolerations":[{"key":"node-role.kubernetes.io/control-plane","operator":"Exists","effect":"NoSchedule"}],
    "volumes":[{"name":"lookout-data","emptyDir":null,"hostPath":{"path":"/fp-store","type":"Directory"}}]}}}}'
  kubectl -n "$NS" rollout status deploy/stub-daemon --timeout=300s
  kubectl -n "$NS" rollout status deploy/lookout-watch --timeout=300s
  sleep 5
  kubectl -n "$NS" logs deploy/lookout-watch --tail=60 >"$SOAK_DIR/sentinel-startup.log"
  grep -iE "source|topology|leeway|enabled|skip" "$SOAK_DIR/sentinel-startup.log" | head -40 || true
}

# follow_sentinel — append the sentinel's log to sentinel.log for as long
# as the run lasts, re-attaching across pod restarts. A re-attach after a
# restart starts with the new container's log, so nothing is repeated.
follow_sentinel() {
  local pod last=""
  while :; do
    pod="$(kubectl -n "$NS" get pod -l app.kubernetes.io/name=lookout-watch -o name 2>/dev/null | head -1)"
    if [[ -n "$pod" ]]; then
      if [[ "$pod" == "$last" ]]; then
        # Same pod: the stream broke; resume from the last minute and
        # accept a little duplication over a gap.
        kubectl -n "$NS" logs "$pod" -f --since=60s >>"$SOAK_DIR/sentinel.log" 2>&1 || true
      else
        echo "### attach $pod $(date -u +%FT%TZ)" >>"$SOAK_DIR/sentinel.log"
        kubectl -n "$NS" logs "$pod" -f >>"$SOAK_DIR/sentinel.log" 2>&1 || true
      fi
      last="$pod"
    fi
    sleep 10
  done
}

# sample — every 10m: the sentinel's metrics (scraped from inside its
# namespace, which deploy/16's NetworkPolicy admits) and a placement
# snapshot (pods per workload per zone and node), so summarize.py can
# check each finding against where the pods actually were.
sample() {
  local ts
  while :; do
    ts="$(date -u +%FT%TZ)"
    {
      echo "### $ts"
      kubectl -n "$NS" exec deploy/stub-daemon -- python -c \
        'import urllib.request,sys;sys.stdout.write(urllib.request.urlopen("http://lookout-watch-metrics:9090/metrics",timeout=20).read().decode())' 2>&1 |
        grep -E '^(lookout_leeway_|lookout_info_dropped_total|lookout_findings_total|lookout_events_injected_total|lookout_watchboard_entries_total|lookout_storms_formed_total|process_resident_memory_bytes|go_memstats_heap_alloc_bytes)' || true
    } >>"$SOAK_DIR/metrics.log"
    {
      echo "### $ts"
      kubectl get nodes -o 'custom-columns=N:.metadata.name,Z:.metadata.labels.topology\.kubernetes\.io/zone,U:.spec.unschedulable,R:.status.conditions[?(@.type=="Ready")].status' --no-headers
      echo "## pods"
      kubectl get pods -A -o 'custom-columns=NS:.metadata.namespace,NAME:.metadata.name,NODE:.spec.nodeName,PHASE:.status.phase,OWNER:.metadata.ownerReferences[0].name' --no-headers
    } >>"$SOAK_DIR/placement.log" 2>&1
    sleep 600
  done
}

cmd_run() {
  local dur="${1:?usage: soak run <duration, e.g. 72h>}"
  local secs
  secs="$(python3 -c 'import re,sys;m={"s":1,"m":60,"h":3600,"d":86400};print(sum(int(n)*m[u] for n,u in re.findall(r"(\d+)([smhd])",sys.argv[1])))' "$dur")"
  ((secs > 0)) || {
    echo "ERROR: bad duration '$dur'" >&2
    exit 2
  }
  local start end
  start="$(date -u +%FT%TZ)"
  end="$(date -u -d "+$secs seconds" +%FT%TZ)"
  {
    echo "start=$start"
    echo "planned_end=$end"
    echo "duration=$dur"
    echo "image=$IMAGE"
    echo "seed=${SOAK_SEED:-416}"
    echo "churn_scale=${SOAK_CHURN_SCALE:-1}"
  } >"$SOAK_DIR/run.env"
  log "run $dur: $start → $end (dir $SOAK_DIR)"

  follow_sentinel &
  local p_follow=$!
  sample &
  local p_sample=$!
  python3 "$here/churn.py" --cluster "$CLUSTER" --seed "${SOAK_SEED:-416}" \
    --scale "${SOAK_CHURN_SCALE:-1}" --duration "$secs" --log "$SOAK_DIR/churn.log" || true
  kill "$p_follow" "$p_sample" 2>/dev/null || true
  pkill -P "$p_follow" 2>/dev/null || true
  pkill -P "$p_sample" 2>/dev/null || true
  echo "actual_end=$(date -u +%FT%TZ)" >>"$SOAK_DIR/run.env"
  # The full container logs as well, in case a follower lost its stream.
  kubectl -n "$NS" logs deploy/lookout-watch >"$SOAK_DIR/sentinel-final.log" 2>&1 || true
  cmd_summary
}

cmd_summary() {
  python3 "$here/summarize.py" "$SOAK_DIR" | tee "$SOAK_DIR/summary.txt"
}

cmd_down() {
  kind delete cluster --name "$CLUSTER"
}

case "${1:-}" in
  up) cmd_up ;;
  run) cmd_run "${2:-}" ;;
  summary) cmd_summary ;;
  down) cmd_down ;;
  *)
    sed -n '/^# Usage:/,/^$/p' "$0" >&2
    exit 2
    ;;
esac
