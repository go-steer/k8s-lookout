# Shared settings for up / grant-iam / run / down. Override any of them
# in the environment.
PROJECT="${PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
ZONE="${ZONE:-us-central1-a}"
REGION="${ZONE%-*}"
CLUSTER="${CLUSTER:-lookout-uat}"
CTX="gke_${PROJECT}_${ZONE}_${CLUSTER}"
NS_RUNNER="lookout-uat"
RUNNER_GSA="lookout-uat-runner"
UNBOUND_GSA="lookout-uat-unbound"
MISSING_GSA="lookout-uat-does-not-exist"
LABELS="purpose=lookout-uat,issue=179-180"
# The published -gke image (T3 is defined on it) and the default image
# (the GCP-free refusal path).
IMAGE_GKE="${IMAGE_GKE:-ghcr.io/go-steer/lookout:v0.37.0-gke}"
IMAGE_DEFAULT="${IMAGE_DEFAULT:-ghcr.io/go-steer/lookout:v0.37.0}"
OUT="${OUT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/out}"
