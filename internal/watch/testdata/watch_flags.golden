# lookout watch CLI flag contract (docs/cli-stability-policy.md)
# Format: <name>\t<type>\t<default>\t<stability>
access-recheck	duration	"2m0s"	stable
alert-excludes	string	""	experimental
autopilot-scale-to-zero-hold	bool	"true"	experimental
ax-ca-file	string	""	stable
ax-router-credential-bundle	string	"/run/podidentity.podcert.ate.dev/credential-bundle.pem"	stable
ax-router-server-name	string	"atenet-router.ate-system.svc"	stable
ax-router-trust-bundle	string	"/run/servicedns-ca/trust-bundle.pem"	stable
ax-router-url	string	"https://atenet-router.ate-system.svc.cluster.local"	stable
ax-server	string	""	stable
ax-server-tls	bool	"false"	stable
ax-task-scope	string	"incident"	stable
ax-task-template	string	""	stable
ax-token-env	string	""	stable
ax-watchboard-task-template	string	""	stable
backoff-min-count	int	"3"	stable
burn-eta	duration	"30m0s"	stable
burn-multiple	float	"4"	stable
capacity-poll	duration	"1m0s"	stable
cluster-name	string	""	frozen
clusters	string	""	stable
clusters-from	string	""	stable
daemon-url	string	""	frozen
dedup-persist	string	""	frozen
dedup-window	duration	"5m0s"	frozen
degradation-drop	float	"0.3"	stable
degradation-window	duration	"15m0s"	stable
distill-interval	duration	"6h0m0s"	stable
dry-run	bool	"false"	frozen
enrich	string	"critical"	stable
enrich-cap	int	"4096"	stable
enrich-lists	string	"all"	stable
enrich-lists-preflight	bool	"false"	stable
enrich-log-lines	int	"200"	stable
enrich-timeout	duration	"5s"	stable
exclude-namespace	string	""	frozen
expiry-acme-grace	duration	"15m0s"	stable
expiry-interval	duration	"1h0m0s"	stable
expiry-namespaces	string	""	stable
expiry-warn	duration	"336h0m0s"	stable
failedscheduling-min-count	int	"5"	experimental
failedscheduling-min-span	duration	"2m0s"	experimental
gateway-grace	duration	"5m0s"	stable
graph-snapshot-interval	duration	"5m0s"	stable
imagepull-transient-min-count	int	"3"	stable
in-cluster	bool	"false"	frozen
inject-max-bytes	int	"8192"	stable
kube-burst	int	"100"	stable
kube-qps	float	"50"	stable
kubeconfig	string	""	frozen
log-level	string	"info"	frozen
metrics-addr	string	""	frozen
mode	string	"per-incident"	frozen
namespace	string	""	frozen
notifications-subscription	string	""	stable
otel-exporter	string	"none"	frozen
owner	string	""	frozen
pending-age	duration	"5m0s"	stable
project	string	""	stable
quota-poll	duration	"15m0s"	stable
quota-warn	float	"0.8"	stable
quota-window	duration	"168h0m0s"	stable
reason	string	""	frozen
recovery-stable-for	duration	"5m0s"	frozen
region	string	""	stable
rollout-observe	duration	"3m0s"	stable
saturation-interval	duration	"30s"	stable
saturation-warn	duration	"1h0m0s"	stable
saturation-window	duration	"1h30m0s"	stable
scaleup-hold	duration	"15m0s"	experimental
settle	duration	"0s"	experimental
severity	repeatable	""	stable
sink	string	"core-agent"	stable
sink-token-env	string	""	stable
sink-url	string	""	stable
snapshot-interval	duration	"30s"	frozen
sources	string	"auto"	stable
store	string	""	stable
store-max-mb	int	"512"	stable
store-ttl	duration	"720h0m0s"	stable
storm	string	"auto"	stable
storm-cluster-fallback	bool	"true"	stable
storm-min	int	"3"	stable
storm-mine	bool	"false"	stable
storm-mine-min	int	"0"	stable
storm-window	duration	"1m0s"	stable
target-session	string	""	frozen
token-budget-usd	float	"0"	stable
token-endpoint	string	""	stable
token-env	string	""	frozen
token-poll	duration	"1m0s"	stable
triage-regress-factor	int	"3"	stable
unhealthy-min-count	int	"3"	frozen
watch-scope	string	"cluster"	stable
watchboard-batch	int	"5"	stable
watchboard-flush	duration	"1m0s"	stable
watchboard-rotate	int	"200"	stable
zone	string	""	stable
