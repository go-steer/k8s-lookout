snapshot-interval	duration	"30s"	frozen
sources	string	"auto"	stable
store	string	""	stable
store-max-mb	int	"512"	stable
store-ttl	duration	"720h0m0s"	stable
storm	string	"auto"	stable
storm-cluster-fallback	bool	"true"	stable
storm-min	int	"3"	stable
storm-mine	bool	"false"	stable
storm-mine-min	int	"0"	stable
storm-window	duration	"1m0s"	stable
target-session	string	""	frozen
token-budget-usd	float	"0"	stable
