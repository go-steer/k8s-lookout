# lookout watch CLI flag contract (docs/cli-stability-policy.md)
# Format: <name>\t<type>\t<default>\t<stability>
access-recheck	duration	"2m0s"	stable
ax-ca-file	string	""	stable
ax-router-credential-bundle	string	"/run/podidentity.podcert.ate.dev/credential-bundle.pem"	stable
ax-router-server-name	string	"atenet-router.ate-system.svc"	stable
ax-router-trust-bundle	string	"/run/servicedns-ca/trust-bundle.pem"	stable
ax-router-url	string	"https://atenet-router.ate-system.svc.cluster.local"	stable
ax-server	string	""	stable
ax-server-tls	bool	"false"	stable
ax-task-scope	string	"incident"	stable
ax-task-template	string	""	stable
ax-token-env	string	""	stable
backoff-min-count	int	"3"	stable
burn-eta	duration	"30m0s"	stable
burn-multiple	float	"4"	stable
capacity-poll	duration	"1m0s"	stable
cluster-name	string	""	frozen
clusters	string	""	stable
clusters-from	string	""	stable
compute-class-dwell	duration	"10m0s"	stable
compute-class-infer	bool	"true"	stable
compute-class-last-rank-ceiling	float	"0.9"	stable
compute-class-rank0-floor	float	"0"	stable
compute-class-tier-c-signals	bool	"false"	stable
compute-class-window	duration	"1h0m0s"	stable
daemon-url	string	""	frozen
dedup-persist	string	""	frozen
dedup-window	duration	"5m0s"	frozen
degradation-drop	float	"0.3"	stable
degradation-window	duration	"15m0s"	stable
distill-interval	duration	"6h0m0s"	stable
dry-run	bool	"false"	frozen
enrich	string	"critical"	stable
enrich-cap	int	"4096"	stable
enrich-lists	string	"all"	stable
enrich-lists-preflight	bool	"false"	stable
enrich-log-lines	int	"200"	stable
enrich-timeout	duration	"5s"	stable
exclude-namespace	string	""	frozen
expiry-acme-grace	duration	"15m0s"	stable
expiry-interval	duration	"1h0m0s"	stable
expiry-namespaces	string	""	stable
expiry-warn	duration	"336h0m0s"	stable
gateway-grace	duration	"5m0s"	stable
graph-snapshot-interval	duration	"5m0s"	stable
