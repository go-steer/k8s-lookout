token-env	string	""	frozen
token-poll	duration	"1m0s"	stable
topology-baseline-band	float	"4"	stable
topology-baseline-half-life	duration	"12h0m0s"	stable
topology-capacity-ratio	float	"1.25"	stable
topology-cluster-defaults	string	""	stable
topology-domain-unavailable-keys	string	"topology.kubernetes.io/zone,topology.kubernetes.io/region"	stable
