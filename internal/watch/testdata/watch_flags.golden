rollout-observe	duration	"3m0s"	stable
saturation-interval	duration	"30s"	stable
saturation-warn	duration	"1h0m0s"	stable
saturation-window	duration	"1h30m0s"	stable
severity	repeatable	""	stable
sink	string	"core-agent"	stable
