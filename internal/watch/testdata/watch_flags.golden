in-cluster	bool	"false"	frozen
inject-max-bytes	int	"8192"	stable
kube-burst	int	"100"	stable
kube-qps	float	"50"	stable
kubeconfig	string	""	frozen
log-level	string	"info"	frozen
metrics-addr	string	""	frozen
mode	string	"per-incident"	frozen
namespace	string	""	frozen
notifications-subscription	string	""	stable
otel-exporter	string	"none"	frozen
owner	string	""	frozen
pending-age	duration	"5m0s"	stable
project	string	""	stable
quota-poll	duration	"15m0s"	stable
quota-warn	float	"0.8"	stable
quota-window	duration	"168h0m0s"	stable
reason	string	""	frozen
recovery-stable-for	duration	"5m0s"	frozen
